---
import siteData from "../data/site.json";
import SchemaMarkup from '../components/SchemaMarkup.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `${siteData.salon.name} - ${siteData.salon.tagline} | ${siteData.salon.city}, ${siteData.salon.state}`,
  description = siteData.hero?.description || `Welcome to ${siteData.salon.name} in ${siteData.salon.city}, ${siteData.salon.state}. Professional manicures, spa pedicures, acrylics, dipping powder, and waxing.`
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteData.url || 'https://sidneynails.com');
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>{title}</title>

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('/images/og-image.webp', canonicalURL)} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/images/og-image.webp', canonicalURL)} />

  <!-- Fonts: Playfair Display + Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <script is:inline>document.documentElement.classList.add("js-enabled");</script>
  <SchemaMarkup />
</head>
<body class="text-brand-charcoal font-body antialiased overflow-x-hidden bg-transparent relative">

  <!-- Fixed Global Ethereal Background (Full-site 3D Parallax Canvas) -->
  <div id="parallax-bg" class="fixed inset-0 -z-50 pointer-events-none overflow-hidden select-none" aria-hidden="true">
    <img 
      id="parallax-bg-img"
      src="/images/background.webp" 
      alt="" 
      class="w-full h-[125%] -top-[12%] relative object-cover object-center will-change-transform" 
      loading="eager"
    />
    <!-- Delicate ambient wash ensuring high contrast for all text content -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/30 via-white/15 to-white/30"></div>
  </div>

  <!-- Translucent Glassmorphism Capsule Navbar -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 py-3.5 md:py-4 px-3 sm:px-6 md:px-8 transition-all duration-300">
    <div id="navbar-pill" class="navbar-glass max-w-[1180px] mx-auto flex justify-between items-center text-white rounded-full px-4 sm:px-6 md:px-7 py-2 md:py-2.5">
      <a class="flex items-center gap-2.5 sm:gap-3 decoration-none group flex-shrink-0" href="/#">
        <div class="w-8 h-8 sm:w-9 sm:h-9 md:w-10 md:h-10 rounded-full bg-white p-0.5 sm:p-1 flex items-center justify-center border border-sky-300/60 shadow-sm flex-shrink-0 overflow-hidden group-hover:scale-105 transition-transform">
          <img class="w-full h-full object-contain rounded-full" src={siteData.salon.logoSquare || '/images/logo.png'} alt={siteData.salon.name} />
        </div>
        <span class="font-display font-bold text-base sm:text-lg md:text-xl text-white tracking-wide">
          {siteData.salon.namePart1} <span class="text-[#9EC5EA] font-normal not-italic">{siteData.salon.namePart2}</span>
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <ul class="hidden lg:flex items-center gap-6 xl:gap-8">
        {siteData.nav.items.map(item => (
          <li>
            <a class="nav-link text-white/85 hover:text-white transition-colors font-body text-[11px] xl:text-xs font-bold tracking-[0.16em] uppercase" data-target={item.href.replace('/#', '')} href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Desktop CTA Button -->
      <div class="hidden md:flex items-center">
        <a class="bg-[#9CBFE4] hover:bg-white text-[#13253B] px-5 sm:px-6 py-2 md:py-2.5 rounded-full font-bold text-xs uppercase tracking-wider transition-all duration-300 shadow-sm hover:shadow hover:-translate-y-0.5" href="/#booking">
          {siteData.nav.ctaText || 'Book Now'}
        </a>
      </div>

      <!-- Mobile Nav Actions -->
      <div class="flex items-center gap-2 lg:hidden">
        <a class="md:hidden bg-[#9CBFE4] hover:bg-white text-[#13253B] px-3.5 py-1.5 rounded-full font-bold text-[11px] uppercase tracking-wider transition-colors shadow-sm" href="/#booking">
          Book
        </a>
        <button 
          type="button" 
          class="flex flex-col justify-center gap-1.5 cursor-pointer p-2 rounded-lg text-white hover:text-brand-gold focus:outline-none" 
          aria-label="Open Navigation Menu"
          onclick="document.getElementById('mobileMenu').classList.remove('translate-x-full'); document.getElementById('mobileMenu').classList.add('translate-x-0');"
        >
          <span class="w-5 h-0.5 bg-white rounded-full"></span>
          <span class="w-5 h-0.5 bg-white rounded-full"></span>
          <span class="w-5 h-0.5 bg-white rounded-full"></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu Drawer -->
  <div class="fixed inset-0 bg-[#1B3A5C]/98 backdrop-blur-md z-[100] translate-x-full transition-transform duration-300 flex flex-col justify-center items-center gap-6 px-6" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <button 
      class="absolute top-6 right-6 text-white text-3xl w-12 h-12 flex items-center justify-center hover:text-brand-gold rounded-full focus:outline-none" 
      aria-label="Close Navigation Menu"
      onclick="document.getElementById('mobileMenu').classList.remove('translate-x-0'); document.getElementById('mobileMenu').classList.add('translate-x-full');"
    >
      &times;
    </button>
    
    <div class="flex items-center gap-3 mb-4">
      <img src={siteData.salon.logoSquare || '/images/logo.png'} alt={siteData.salon.name} class="h-12 w-12 rounded-full bg-white p-1" />
      <span class="font-display text-2xl font-medium text-white">{siteData.salon.name}</span>
    </div>

    {siteData.nav.items.map(item => (
      <a class="nav-link text-white/90 text-xl font-display tracking-wider hover:text-brand-gold transition-colors py-1" data-target={item.href.replace('/#', '')} href={item.href} onclick="document.getElementById('mobileMenu').classList.remove('translate-x-0'); document.getElementById('mobileMenu').classList.add('translate-x-full');">
        {item.label}
      </a>
    ))}

    <div class="pt-4 flex flex-col items-center gap-3 w-full max-w-xs">
      <a class="w-full text-center bg-brand-gold text-[#1B3A5C] py-3 rounded-full font-bold uppercase tracking-wider text-sm hover:bg-white transition-colors" href="/#booking" onclick="document.getElementById('mobileMenu').classList.remove('translate-x-0'); document.getElementById('mobileMenu').classList.add('translate-x-full');">
        {siteData.nav.ctaText || 'Book Now'}
      </a>
      <a class="text-white/80 hover:text-brand-gold text-sm tracking-wide transition-colors py-2" href={`tel:${siteData.salon.phoneRaw}`}>
        Call {siteData.salon.phone}
      </a>
    </div>
  </div>

  <slot />

  <!-- Collapsible Social Sidebar -->
  <div id="social-sidebar" class="fixed left-0 top-1/2 -translate-y-1/2 z-[90] flex flex-col bg-white shadow-xl rounded-r-2xl border border-slate-200 w-[48px] md:w-[54px] py-2 transition-transform duration-300 -translate-x-full md:translate-x-0">
    <button id="social-toggle" class="md:hidden absolute top-1/2 -translate-y-1/2 -right-9 w-9 h-12 bg-white border border-slate-200 border-l-0 shadow-md rounded-r-xl flex items-center justify-center text-brand-charcoal hover:text-brand-gold transition-colors focus:outline-none" aria-label="Toggle Social Links">
      <svg id="social-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <div class="flex flex-col w-full items-center">
      <!-- Facebook -->
      {siteData.social.facebook && (
        <a href={siteData.social.facebook.startsWith('TODO') ? 'https://www.facebook.com' : siteData.social.facebook} target="_blank" rel="noopener noreferrer" class="py-3 flex justify-center items-center text-slate-600 hover:text-[#1877F2] transition-colors group" aria-label="Facebook">
          <svg class="w-5 h-5 group-hover:scale-110 transition-transform duration-200" viewBox="0 0 320 512" fill="currentColor"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
        </a>
      )}
      
      <div class="w-6 mx-auto h-px bg-slate-200"></div>

      <!-- Instagram -->
      {siteData.social.instagram && (
        <a href={siteData.social.instagram.startsWith('TODO') ? 'https://www.instagram.com' : siteData.social.instagram} target="_blank" rel="noopener noreferrer" class="py-3 flex justify-center items-center text-slate-600 hover:text-[#E1306C] transition-colors group" aria-label="Instagram">
          <svg class="w-5 h-5 group-hover:scale-110 transition-transform duration-200" viewBox="0 0 448 512" fill="currentColor"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
        </a>
      )}

      <div class="w-6 mx-auto h-px bg-slate-200"></div>

      <!-- Google Maps -->
      {siteData.social.googleMaps && (
        <a href={siteData.social.googleMaps} target="_blank" rel="noopener noreferrer" class="py-3 flex justify-center items-center text-slate-600 hover:text-[#4285F4] transition-colors group" aria-label="Google Maps">
          <svg class="w-5 h-5 group-hover:scale-110 transition-transform duration-200" viewBox="0 0 488 512" fill="currentColor"><path d="M488 261.8C488 403.3 391.1 504 248 504 110.8 504 0 393.2 0 256S110.8 8 248 8c66.8 0 123 24.5 166.3 64.9l-67.5 64.9C258.5 52.6 94.3 116.6 94.3 256c0 86.5 69.1 156.6 153.7 156.6 98.2 0 135-70.4 140.8-106.9H248v-85.3h236.1c2.3 12.7 3.9 24.9 3.9 41.4z"/></svg>
        </a>
      )}
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-[#1B3A5C] text-white/80 pt-20 pb-10 px-6 sm:px-8 border-t border-[#2D5A8B]/40">
    <div class="max-w-[1180px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
        <!-- Brand Summary -->
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <img src={siteData.salon.logoSquare || '/images/logo.png'} alt={siteData.salon.name} class="h-10 w-10 rounded-full bg-white p-0.5 object-contain" />
            <span class="font-display text-2xl font-medium text-white">{siteData.salon.name}</span>
          </div>
          <p class="text-sm text-white/70 leading-relaxed font-light">
            A serene beauty salon in Sidney, MT. Personalized nail care, soothing spa pedicures, and beauty treatments in a calm, welcoming setting.
          </p>
          <div class="text-xs text-white/60 space-y-1 pt-2">
            <p>{siteData.salon.fullAddress}</p>
            <p><a href={`tel:${siteData.salon.phoneRaw}`} class="text-brand-gold hover:text-white transition-colors">{siteData.salon.phone}</a></p>
          </div>
        </div>

        <!-- Services -->
        <div>
          <h5 class="text-white text-xs font-bold tracking-[0.2em] uppercase mb-5">Our Services</h5>
          <ul class="space-y-3 text-sm font-light text-white/75">
            {siteData.services.items.map(item => (
              <li><a class="hover:text-brand-gold transition-colors" href="/#pricing">{item.title || item.name}</a></li>
            ))}
          </ul>
        </div>

        <!-- Quick Links -->
        <div>
          <h5 class="text-white text-xs font-bold tracking-[0.2em] uppercase mb-5">Quick Links</h5>
          <ul class="space-y-3 text-sm font-light text-white/75">
            {siteData.nav.items.map(item => (
              <li><a class="hover:text-brand-gold transition-colors" href={item.href}>{item.label}</a></li>
            ))}
            <li><a class="hover:text-brand-gold transition-colors" href="/policies">Salon Policies</a></li>
            <li><a class="hover:text-brand-gold transition-colors" href="/privacy">Privacy Policy</a></li>
            <li><a class="hover:text-brand-gold transition-colors" href="/terms">Terms of Service</a></li>
          </ul>
        </div>

        <!-- Hours & Location -->
        <div>
          <h5 class="text-white text-xs font-bold tracking-[0.2em] uppercase mb-5">Hours & Visit</h5>
          <div class="space-y-2 text-sm font-light text-white/75 mb-6">
            <p><strong class="font-medium text-white">Mon – Sat:</strong> {siteData.hours['Mon-Sat'] || '10:00 AM – 7:00 PM'}</p>
            <p><strong class="font-medium text-white">Sunday:</strong> {siteData.hours['Sunday'] || '11:00 AM – 5:00 PM'}</p>
            <p class="text-xs text-brand-gold pt-1">Walk-ins welcome & appointments available</p>
          </div>
          <a href={siteData.map.directionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-brand-gold hover:text-white transition-colors">
            Get Directions &rarr;
          </a>
        </div>
      </div>

      <!-- Copyright Bar -->
      <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-white/60">
        <span>&copy; {new Date().getFullYear()} {siteData.salon.name}. All rights reserved.</span>
        <span>422 N Central Ave, Sidney, MT 59270 &middot; <a class="hover:text-brand-gold transition-colors" href={`tel:${siteData.salon.phoneRaw}`}>{siteData.salon.phone}</a></span>
      </div>
    </div>
  </footer>

  <!-- Mobile Bottom Action Dock (Clean, non-intrusive 1-tap mobile booking) -->
  <div class="md:hidden fixed bottom-3 left-3 right-3 z-40 navbar-glass rounded-full px-4 py-2 flex items-center justify-between" role="navigation" aria-label="Quick Actions">
    <a href={`tel:${siteData.salon.phoneRaw}`} class="flex items-center gap-2 text-white/90 hover:text-white text-xs font-semibold">
      <span class="w-8 h-8 rounded-full bg-brand-gold/20 flex items-center justify-center text-brand-gold">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
      </span>
      <span>Call {siteData.salon.phone}</span>
    </a>
    <a href="/#booking" class="bg-[#9CBFE4] text-[#13253B] px-5 py-2 rounded-full font-bold text-xs uppercase tracking-wider shadow-sm active:scale-95 transition-transform">
      Book Now
    </a>
  </div>

  <script is:inline>
    // Bulletproof Staggered Entrance & Scroll Reveal + 3D Parallax
    function initAnimations() {
      // 1. Accessibility check: if user prefers reduced motion, reveal everything immediately
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('.reveal, .reveal-scale, .reveal-left, .reveal-right').forEach(el => {
          el.classList.add('is-revealed');
        });
        return;
      }

      // 2. Partition reveals into Hero load sequence vs Scroll reveals
      const allReveals = document.querySelectorAll('.reveal, .reveal-scale, .reveal-left, .reveal-right');
      const heroReveals = [];
      const scrollReveals = [];

      allReveals.forEach(el => {
        if (el.closest('#hero')) {
          heroReveals.push(el);
        } else {
          scrollReveals.push(el);
        }
      });

      // 3. Hero Elements: Load-in Sequence
      let heroDelay = 80;
      heroReveals.forEach((el) => {
        const customDelay = el.style.getPropertyValue('--reveal-delay');
        if (!customDelay) {
          el.style.setProperty('--reveal-delay', `${heroDelay}ms`);
          heroDelay += 130;
        }
        setTimeout(() => {
          el.classList.add('is-revealed');
        }, 50);
      });

      // 4. Scroll Reveals via IntersectionObserver
      if ('IntersectionObserver' in window) {
        const observerOptions = {
          rootMargin: '0px 0px -60px 0px',
          threshold: 0.12
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target;
              // If element has sibling cards inside the same parent grid, stagger them smoothly
              const parent = el.parentElement;
              if (parent && (parent.classList.contains('grid') || parent.classList.contains('flex'))) {
                const siblings = Array.from(parent.children).filter(c => c.matches('.reveal, .reveal-scale, .reveal-left, .reveal-right'));
                if (siblings.length > 1) {
                  const sIdx = siblings.indexOf(el);
                  const existingDelay = el.style.getPropertyValue('--reveal-delay');
                  if (!existingDelay && sIdx >= 0) {
                    el.style.setProperty('--reveal-delay', `${(sIdx % 4) * 90}ms`);
                  }
                }
              }
              el.classList.add('is-revealed');
              observer.unobserve(el);
            }
          });
        }, observerOptions);

        scrollReveals.forEach((el) => {
          // If already in initial viewport on page load (e.g. short viewport or scrolled restore)
          const rect = el.getBoundingClientRect();
          const windowHeight = window.innerHeight || document.documentElement.clientHeight;
          if (rect.top < windowHeight * 0.88 && rect.bottom > 0) {
            setTimeout(() => el.classList.add('is-revealed'), 120);
          } else {
            observer.observe(el);
          }
        });
      } else {
        scrollReveals.forEach(el => el.classList.add('is-revealed'));
      }

      // 4. Silky 3D Parallax Scroll on Background Canvas
      const bgImg = document.getElementById('parallax-bg-img');
      if (bgImg) {
        let isTicking = false;
        const updateParallax = () => {
          const scrollY = window.pageYOffset || document.documentElement.scrollTop;
          // Smooth 12% vertical shift creates undeniable 3D depth relative to foreground cards
          const offset = scrollY * 0.12;
          bgImg.style.transform = `translate3d(0, ${offset}px, 0)`;
          isTicking = false;
        };

        window.addEventListener('scroll', () => {
          if (!isTicking) {
            window.requestAnimationFrame(updateParallax);
            isTicking = true;
          }
        }, { passive: true });
        updateParallax();
      }

      // 5. Navbar condense on scroll
      const navPill = document.getElementById('navbar-pill');
      const navbar = document.getElementById('navbar');
      if (navPill && navbar) {
        const onScroll = () => {
          if (window.scrollY > 40) {
            navbar.classList.remove('py-3.5', 'md:py-4');
            navbar.classList.add('py-2', 'md:py-2.5');
            navPill.classList.add('is-scrolled');
          } else {
            navbar.classList.remove('py-2', 'md:py-2.5');
            navbar.classList.add('py-3.5', 'md:py-4');
            navPill.classList.remove('is-scrolled');
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // 6. Social sidebar toggle on mobile
      const sidebar = document.getElementById('social-sidebar');
      const toggleBtn = document.getElementById('social-toggle');
      const icon = document.getElementById('social-icon');
      let isOpen = false;
      if (toggleBtn && sidebar && icon) {
        toggleBtn.addEventListener('click', () => {
          isOpen = !isOpen;
          if (isOpen) {
            sidebar.classList.remove('-translate-x-full');
            sidebar.classList.add('translate-x-0');
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />';
          } else {
            sidebar.classList.remove('translate-x-0');
            sidebar.classList.add('-translate-x-full');
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />';
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAnimations);
    } else {
      initAnimations();
    }
    document.addEventListener('astro:page-load', initAnimations);
  </script>
</body>
</html>
