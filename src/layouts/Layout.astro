---
import '../styles/global.css';
import siteData from '../data/site.json';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{`${siteData.salon.name} - ${siteData.salon.tagline} | ${siteData.salon.city}, ${siteData.salon.state}`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- NAV -->
  <nav id="navbar">
    <div class="nav-inner">
      <a class="logo" href="#">
        <img class="logo-img" src={siteData.salon.logoImage} alt={siteData.salon.name} />
        <span class="logo-text">{siteData.salon.namePart1} <i>{siteData.salon.namePart2}</i></span>
      </a>
      <ul class="nav-links">
        {siteData.nav.items.map(item => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a class="nav-cta" href="/#booking">{siteData.nav.ctaText}</a>
      <div class="hamburger" onclick="document.getElementById('mobileMenu').classList.add('open')">
        <span></span><span></span><span></span>
      </div>
    </div>
  </nav>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobileMenu">
    <button class="mobile-close" onclick="this.parentElement.classList.remove('open')">&times;</button>
    {siteData.nav.items.map(item => (
      <a href={item.href} onclick="this.parentElement.classList.remove('open')">{item.label}</a>
    ))}
    <a class="nav-cta" href={`tel:${siteData.salon.phoneRaw}`} onclick="this.parentElement.classList.remove('open')">Call {siteData.salon.phone}</a>
  </div>

  <slot />

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-brand">
          <span class="logo-text" style="font-family:var(--font-display);font-size:1.4rem;font-weight:700;color:var(--white)">{siteData.salon.namePart1} <i style="color:var(--gold-light);font-style:normal">{siteData.salon.namePart2}</i></span>
          <p>Premium nail salon at {siteData.salon.fullAddress}. We bring luxury, cleanliness, and exceptional nail artistry to every visit.</p>
        </div>
        <div class="f-col">
          <h5>Services</h5>
          <ul>
            {siteData.services.items.map(item => (
              <li><a href="#services">{item.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="f-col">
          <h5>Quick Links</h5>
          <ul>
            {siteData.nav.items.map(item => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
            <li><a href="/policies">Policies</a></li>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Service</a></li>
          </ul>
        </div>
        <div class="f-col">
          <h5>Follow Us</h5>
          <ul>
            {siteData.social.facebook && <li><a href={siteData.social.facebook}>Facebook</a></li>}
            {siteData.social.instagram && <li><a href={siteData.social.instagram}>Instagram</a></li>}
            {siteData.social.tiktok && <li><a href={siteData.social.tiktok}>TikTok</a></li>}
            {siteData.social.googleMaps && <li><a href={siteData.social.googleMaps}>Google Maps</a></li>}
          </ul>
        </div>
      </div>
      <div class="footer-line">
        <span>&copy; <span>{new Date().getFullYear()}</span> <span>{siteData.salon.name}</span>. All rights reserved.</span>
        <span><a href={`tel:${siteData.salon.phoneRaw}`} style="color:inherit; text-decoration:none;">Call us: {siteData.salon.phone}</a></span>
      </div>
    </div>
  </footer>

  <!-- CTA FLOAT -->
  <a class="cta-float" href="/#booking" title={`Book at ${siteData.salon.name}`}>
    📅
    <span class="cta-pulse"></span>
  </a>

  <!-- SCRIPTS -->
  <script is:inline>
    const nav = document.getElementById('navbar');
    window.addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 60));
    
    const reveals = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver(entries => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => e.target.classList.add('visible'), i * 80);
          io.unobserve(e.target);
        }
      });
    }, { threshold: .12 });
    reveals.forEach(el => io.observe(el));
    
    document.querySelectorAll('a[href^="/#"], a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const href = a.getAttribute('href');
        const hash = href.startsWith('/#') ? href.substring(1) : href;
        if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
          const t = document.querySelector(hash);
          if (t) {
            e.preventDefault();
            t.scrollIntoView({ behavior: 'smooth', block: 'start' });
            // Close mobile menu if open
            const mobileMenu = document.getElementById('mobileMenu');
            if(mobileMenu.classList.contains('open')) mobileMenu.classList.remove('open');
          }
        }
      });
    });
  </script>
</body>
</html>
