---
import '../styles/global.css';
import siteData from '../data/site.json';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{`${siteData.salon.name} - ${siteData.salon.tagline} | ${siteData.salon.city}, ${siteData.salon.state}`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add("js-enabled");</script>
</head>
<body class="bg-brand-cream text-brand-charcoal font-body antialiased">
  <!-- NAV -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-4 md:px-8">
    <div class="max-w-[1200px] mx-auto flex justify-between items-center bg-brand-charcoal/90 backdrop-blur-md border border-white/5 rounded-full px-6 py-2.5 shadow-soft">
      <a class="flex items-center gap-3 decoration-none" href="#">
        <img class="h-10 w-10 md:h-12 md:w-12 rounded-full object-cover border-2 border-brand-gold/30" src={siteData.salon.logoImage} alt={siteData.salon.name} />
        <span class="font-display font-bold text-xl md:text-2xl text-white tracking-wide">{siteData.salon.namePart1} <i class="text-brand-goldLight not-italic font-medium">{siteData.salon.namePart2}</i></span>
      </a>
      <ul class="hidden lg:flex items-center gap-8">
        {siteData.nav.items.map(item => (
          <li><a class="text-brand-cream/80 hover:text-brand-gold transition-colors font-body text-sm font-medium tracking-wider uppercase" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a class="hidden md:inline-block bg-brand-gold text-brand-charcoal px-6 py-2.5 rounded-full font-bold text-sm uppercase tracking-wide hover:bg-brand-goldLight hover:shadow-glow transition-all duration-300 hover:-translate-y-0.5" href="/#booking">{siteData.nav.ctaText}</a>
      <div class="lg:hidden flex flex-col gap-1.5 cursor-pointer z-[100]" onclick="document.getElementById('mobileMenu').classList.add('translate-x-0')">
        <span class="w-6 h-0.5 bg-brand-cream rounded-full"></span>
        <span class="w-6 h-0.5 bg-brand-cream rounded-full"></span>
        <span class="w-6 h-0.5 bg-brand-cream rounded-full"></span>
      </div>
    </div>
  </nav>

  <!-- MOBILE MENU -->
  <div class="fixed inset-0 bg-brand-charcoal/95 backdrop-blur-xl z-[100] translate-x-full transition-transform duration-500 flex flex-col justify-center items-center gap-8" id="mobileMenu">
    <button class="absolute top-6 right-6 text-brand-cream text-4xl w-12 h-12 flex items-center justify-center" onclick="this.parentElement.classList.remove('translate-x-0')">&times;</button>
    {siteData.nav.items.map(item => (
      <a class="text-brand-cream text-2xl font-display tracking-widest hover:text-brand-gold transition-colors" href={item.href} onclick="this.parentElement.classList.remove('translate-x-0')">{item.label}</a>
    ))}
    <a class="mt-4 bg-brand-gold text-brand-charcoal px-8 py-3 rounded-full font-bold uppercase tracking-wider" href={`tel:${siteData.salon.phoneRaw}`} onclick="this.parentElement.classList.remove('translate-x-0')">Call {siteData.salon.phone}</a>
  </div>

  <slot />

  <!-- FOOTER -->
  <footer class="bg-brand-charcoal text-brand-cream/70 pt-20 pb-8 px-6">
    <div class="max-w-[1200px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
        <div class="footer-brand">
          <span class="font-display text-2xl font-bold text-white mb-4 block">{siteData.salon.namePart1} <i class="text-brand-goldLight not-italic font-medium">{siteData.salon.namePart2}</i></span>
          <p class="text-sm leading-relaxed">Premium nail salon at {siteData.salon.fullAddress}. We bring luxury, cleanliness, and exceptional nail artistry to every visit.</p>
        </div>
        <div class="f-col">
          <h5 class="text-white text-xs font-bold tracking-[0.2em] uppercase mb-5">Services</h5>
          <ul class="space-y-3 text-sm">
            {siteData.services.items.map(item => (
              <li><a class="hover:text-brand-goldLight transition-colors" href="#services">{item.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="f-col">
          <h5 class="text-white text-xs font-bold tracking-[0.2em] uppercase mb-5">Quick Links</h5>
          <ul class="space-y-3 text-sm">
            {siteData.nav.items.map(item => (
              <li><a class="hover:text-brand-goldLight transition-colors" href={item.href}>{item.label}</a></li>
            ))}
            <li><a class="hover:text-brand-goldLight transition-colors" href="/policies">Policies</a></li>
            <li><a class="hover:text-brand-goldLight transition-colors" href="/privacy">Privacy Policy</a></li>
            <li><a class="hover:text-brand-goldLight transition-colors" href="/terms">Terms of Service</a></li>
          </ul>
        </div>
        <div class="f-col">
          <h5 class="text-white text-xs font-bold tracking-[0.2em] uppercase mb-5">Follow Us</h5>
          <ul class="space-y-3 text-sm">
            {siteData.social.facebook && <li><a class="hover:text-brand-goldLight transition-colors" href={siteData.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>}
            {siteData.social.instagram && <li><a class="hover:text-brand-goldLight transition-colors" href={siteData.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>}
            {siteData.social.tiktok && <li><a class="hover:text-brand-goldLight transition-colors" href={siteData.social.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a></li>}
            {siteData.social.yelp && <li><a class="hover:text-brand-goldLight transition-colors" href={siteData.social.yelp} target="_blank" rel="noopener noreferrer">Yelp</a></li>}
            {siteData.social.googleMaps && <li><a class="hover:text-brand-goldLight transition-colors" href={siteData.social.googleMaps} target="_blank" rel="noopener noreferrer">Google Maps</a></li>}
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs">
        <span>&copy; <span>{new Date().getFullYear()}</span> <span class="font-medium text-white">{siteData.salon.name}</span>. All rights reserved.</span>
        <span><a class="hover:text-brand-goldLight transition-colors" href={`tel:${siteData.salon.phoneRaw}`}>Call us: {siteData.salon.phone}</a></span>
      </div>
    </div>
  </footer>

  <!-- CTA FLOAT -->
  <a class="fixed bottom-6 right-6 z-[99] w-14 h-14 rounded-full bg-brand-gold text-brand-charcoal flex items-center justify-center shadow-glow hover:scale-110 transition-transform duration-300" href="/#booking" title={`Book at ${siteData.salon.name}`}>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
    <span class="absolute -inset-1.5 border-2 border-brand-gold rounded-full opacity-0 animate-[pulse-ring_2s_ease-out_infinite]"></span>
  </a>

  <style is:global>
    /* Pulse for CTA */
    @keyframes pulse-ring {
      0% { transform: scale(0.8); opacity: 0.8; }
      100% { transform: scale(1.3); opacity: 0; }
    }
    
    /* Taste-skill approved smooth bezier out-quart for elements */
    .reveal {
      opacity: 0; 
      transform: translateY(40px); 
      transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .reveal.visible {
      opacity: 1; 
      transform: translateY(0);
    }
    
    .animate-fade-in-up {
      animation: fadeUpElegance 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes fadeUpElegance {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    /* Shine effect for buttons */
    @keyframes shine {
      0% { left: -100%; }
      20% { left: 100%; }
      100% { left: 100%; }
    }
    .btn-shine {
      position: relative;
      overflow: hidden;
    }
    .btn-shine::after {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 50%; height: 100%;
      background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 100%);
      transform: skewX(-20deg);
      animation: shine 5s infinite;
    }
    
    /* Slow spin for decorative stars */
    @keyframes spin-slow {
      100% { transform: rotate(360deg); }
    }
    .animate-spin-slow {
      animation: spin-slow 8s linear infinite;
      display: inline-block;
    }
  </style>

  <!-- SCRIPTS -->
  <script is:inline>
    const nav = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      if (scrollY > 60) {
        nav.classList.replace('py-4', 'py-2');
      } else {
        nav.classList.replace('py-2', 'py-4');
      }
    });
    
    // Advanced staggered reveal matching Luxury UI specs
    const reveals = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver(entries => {
      const intersecting = entries.filter(e => e.isIntersecting);
      intersecting.forEach((e, i) => {
        // Delay by 150ms per item in the batch for elegant cascading effect
        setTimeout(() => e.target.classList.add('visible'), i * 150);
        io.unobserve(e.target);
      });
    }, { 
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px"
    });
    reveals.forEach(el => io.observe(el));
    
    document.querySelectorAll('a[href^="/#"], a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const href = a.getAttribute('href');
        const hash = href.startsWith('/#') ? href.substring(1) : href;
        if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
          const t = document.querySelector(hash);
          if (t) {
            e.preventDefault();
            t.scrollIntoView({ behavior: 'smooth', block: 'start' });
            const mobileMenu = document.getElementById('mobileMenu');
            if(mobileMenu.classList.contains('translate-x-0')) mobileMenu.classList.remove('translate-x-0');
          }
        }
      });
    });
  </script>

  <!-- PROMO POPUP MODAL (Shopee Style) -->
  <div id="promoPopup" class="fixed inset-0 z-[1000] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300" aria-modal="true" role="dialog">
    <!-- Nền đen tối lại, KHÔNG làm mờ (No blur) -->
    <div class="absolute inset-0 bg-black/60 cursor-pointer" onclick="closePromoPopup()"></div>
    
    <!-- Khung chứa ảnh (Bỏ overflow-hidden để nút X có thể tràn ra ngoài) -->
    <div class="relative w-[90%] max-w-[500px] scale-75 transition-transform duration-500 ease-out-back" id="promoContent">
      
      <!-- Nút X (Tròn trắng, văng ra ngoài góc trên bên phải giống Shopee) -->
      <button onclick="closePromoPopup()" class="absolute -top-3 -right-3 z-20 w-8 h-8 bg-white hover:bg-gray-100 text-gray-500 rounded-full flex items-center justify-center shadow-lg transition-colors border border-gray-200" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      
      <img src="/images/promo-popup.jpg" alt="10% Off All Services - Thank You" class="w-full h-auto object-cover rounded-lg shadow-2xl relative z-10" />
    </div>
  </div>

  <style is:inline>
    /* Hiệu ứng nảy nhẹ (bounce) giống e-commerce */
    .ease-out-back { transition-timing-function: cubic-bezier(0.175, 0.885, 0.32, 1.15); }
    #promoPopup.active { opacity: 1; pointer-events: auto; }
    #promoPopup.active #promoContent { transform: scale(1); }
  </style>

  <script is:inline>
    function closePromoPopup() {
      const popup = document.getElementById('promoPopup');
      popup.classList.remove('active');
    }

    window.addEventListener('DOMContentLoaded', () => {
      // Shopee style: Hiện lên nhanh hơn (sau 0.5s) thay vì chờ quá lâu
      setTimeout(() => {
        document.getElementById('promoPopup').classList.add('active');
      }, 500);
    });
  </script>

</body>
</html>
