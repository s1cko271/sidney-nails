---
import siteData from '../data/site.json';
---
<section class="py-24 md:py-32 bg-brand-cream text-brand-charcoal overflow-hidden" id="about">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
      
      <!-- Image Group -->
      <div class="relative w-full lg:w-1/2 flex justify-center lg:justify-start reveal">
        <img class="w-full sm:w-[85%] mx-auto aspect-[4/5] object-cover rounded-[3rem] md:rounded-[4rem] border-[3px] border-brand-luxury shadow-glow" src={siteData.about.image} alt={`${siteData.salon.name} Storefront`} />
        
        <div class="absolute -bottom-2 -right-2 sm:-bottom-6 sm:-right-4 bg-brand-charcoal text-brand-cream p-7 md:p-9 rounded-[2rem] border-[3px] border-brand-luxury shadow-glow flex flex-col items-center justify-center transform hover:scale-105 transition-transform duration-500">
          <div class="text-[0.7rem] font-bold tracking-[0.2em] uppercase text-brand-goldLight mb-1 text-center">{siteData.about.badgeLabel}</div>
          <div class="font-display lining-nums text-3xl md:text-4xl font-semibold text-white tracking-wide">{siteData.about.badgeValue}</div>
        </div>
      </div>
      
      <!-- Text Group -->
      <div class="w-full lg:w-1/2 mt-12 lg:mt-0 reveal">
        <div class="inline-block text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase mb-4">
          {siteData.about.sectionTag}
        </div>
        
        <h2 class="font-display lining-nums text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-8 text-brand-charcoal">
          {siteData.about.title} <br/>
          <span class="font-semibold italic text-brand-gold">{siteData.about.titleAccent}</span>
        </h2>
        
        <div class="space-y-6 text-brand-charcoal/75 leading-relaxed font-body font-light mb-10">
          {siteData.about.paragraphs.map((para) => (
            <p class="text-[0.95rem] md:text-base text-justify">{para}</p>
          ))}
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {siteData.about.highlights.map(highlight => (
            <div class="flex items-center gap-3 text-sm font-medium text-brand-charcoal/90">
              <span class="text-brand-gold text-lg opacity-80 transition-transform duration-700 hover:scale-110"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 22C12 22 20 18 20 12C20 6 12 2 12 2C12 2 4 6 4 12C4 18 12 22 12 22Z"/></svg></span> {highlight}
            </div>
          ))}
        </div>
        
      </div>
    </div>
  </div>
</section>
