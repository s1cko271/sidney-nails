---
import siteData from '../data/site.json';
---
<section class="py-24 md:py-32 bg-brand-cream text-brand-charcoal overflow-hidden" id="about">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
      
      <!-- Image Group -->
      <div class="relative w-full lg:w-1/2 flex justify-center lg:justify-start reveal">
        <img class="w-full sm:w-[85%] mx-auto aspect-[4/5] object-cover rounded-2xl border-[6px] border-white shadow-[0_15px_40px_rgba(0,0,0,0.12)] hover:shadow-2xl transition-shadow duration-500" src={siteData.salon.interiorImage} alt={`${siteData.salon.name} Interior`} />
        
        <div class="absolute -bottom-4 -right-2 sm:-bottom-8 sm:-right-8 bg-gradient-to-br from-brand-charcoal to-[#0a0a0a] text-brand-cream p-6 md:p-8 rounded-2xl shadow-[0_15px_30px_rgba(0,0,0,0.2)] border-2 md:border-4 border-brand-gold flex flex-col items-center justify-center hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(212,175,55,0.25)] transition-all duration-500 group cursor-default">
          <div class="text-[0.7rem] font-bold tracking-[0.2em] uppercase text-brand-goldLight mb-1 text-center">{siteData.about.badgeLabel}</div>
          <div class="font-display text-4xl md:text-5xl font-semibold text-white group-hover:text-brand-goldLight transition-colors duration-300">{siteData.about.badgeValue}</div>
        </div>
      </div>
      
      <!-- Text Group -->
      <div class="w-full lg:w-1/2 mt-12 lg:mt-0 reveal">
        <div class="inline-block text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase mb-4">
          {siteData.about.sectionTag}
        </div>
        
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-8 text-brand-charcoal">
          {siteData.about.title} <br/>
          <span class="font-semibold italic text-brand-gold">{siteData.about.titleAccent}</span>
        </h2>
        
        <div class="space-y-6 text-brand-charcoal/75 leading-relaxed font-body font-light mb-10">
          {siteData.about.paragraphs.map((para) => (
            <p class="text-[0.95rem] md:text-base">{para}</p>
          ))}
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {siteData.about.highlights.map(highlight => (
            <div class="flex items-center gap-3 text-sm font-medium text-brand-charcoal/90">
              <span class="text-brand-gold text-lg animate-spin-slow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z"/></svg></span> {highlight}
            </div>
          ))}
        </div>
        
      </div>
    </div>
  </div>
</section>
