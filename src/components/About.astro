---
import siteData from '../data/site.json';
---
<section class="py-24 md:py-32 bg-brand-cream relative" id="about">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-8">
    <div class="relative w-full aspect-[4/3] md:aspect-[21/9] rounded-2xl overflow-hidden shadow-2xl reveal">
      <img src={siteData.salon.exteriorImage} alt="Sidney Nails Exterior" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-brand-luxury/20 mix-blend-multiply"></div>
      
      <!-- Overlapping Card -->
      <div class="absolute -bottom-px sm:bottom-8 sm:right-8 bg-brand-cream w-full sm:w-[90%] md:w-[450px] p-8 md:p-12 rounded-t-2xl sm:rounded-2xl shadow-floating reveal" style="transition-delay: 200ms;">
        <h2 class="font-display text-3xl md:text-4xl leading-tight mb-6 text-brand-charcoal">
          {siteData.about.title} <br/>
          <em class="font-medium italic text-brand-gold">{siteData.about.titleAccent}</em>
        </h2>
        
        <p class="text-brand-charcoal/70 text-sm leading-relaxed mb-8 font-body">
          {siteData.about.description}
        </p>

        <div class="grid grid-cols-2 gap-6 pt-6 border-t border-brand-offwhite">
          {siteData.about.stats && siteData.about.stats.map(stat => (
            <div>
              <div class="font-display text-2xl md:text-3xl font-medium text-brand-luxury mb-1">{stat.value}</div>
              <div class="text-[0.65rem] uppercase tracking-widest text-brand-charcoal/50 font-semibold">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
