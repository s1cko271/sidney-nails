---
import siteData from '../data/site.json';
---
<section class="py-24 bg-white relative overflow-hidden" id="about">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left: Visual Composition (5 cols on lg) -->
      <div class="lg:col-span-5 relative reveal">
        <div class="relative rounded-3xl overflow-hidden shadow-xl border border-slate-200 aspect-[4/5] bg-brand-offwhite">
          <img 
            src="/images/salon-2.webp" 
            alt="Sidney Nails storefront at 422 N Central Ave" 
            class="w-full h-full object-cover" 
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#1B3A5C]/40 via-transparent to-transparent"></div>
        </div>

        <!-- Float Badge -->
        <div class="absolute -bottom-5 -right-3 md:-right-5 bg-[#1B3A5C] text-white p-5 md:p-6 rounded-2xl shadow-xl border border-[#2D5A8B] max-w-[200px]">
          <div class="text-[0.65rem] font-bold uppercase tracking-widest text-brand-gold mb-1">Local &amp; Welcoming</div>
          <p class="font-display text-lg font-medium leading-snug">Sidney, Montana</p>
          <p class="text-xs text-white/70 font-light mt-0.5">422 N Central Ave</p>
        </div>
      </div>

      <!-- Right: Narrative & Details (7 cols on lg) -->
      <div class="lg:col-span-7 lg:pl-6 reveal">
        <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-3">
          Our Story
        </div>
        
        <h2 class="font-display text-4xl md:text-5xl font-normal text-brand-charcoal mb-6 leading-tight">
          Warm &amp; Personal Care <br/>
          <em class="italic font-medium text-brand-gold">In the Heart of Sidney</em>
        </h2>

        <p class="text-slate-600 text-base md:text-lg leading-relaxed font-light mb-6">
          {siteData.about.description}
        </p>

        <p class="text-slate-500 text-sm leading-relaxed font-light mb-10">
          Whether you are stopping by for regular nail upkeep or spending an afternoon relaxing with our signature spa pedicure, our team takes the time to listen, care, and deliver beautiful results tailored to you.
        </p>

        <!-- Stats / Commitments -->
        <div class="grid grid-cols-2 gap-6 pt-8 border-t border-slate-200">
          {siteData.about.stats.map(stat => (
            <div class="bg-brand-offwhite p-5 rounded-xl border border-slate-200/80">
              <div class="font-display text-2xl md:text-3xl font-medium text-[#1B3A5C] mb-1">
                {stat.value}
              </div>
              <div class="text-[0.7rem] uppercase tracking-wider text-slate-500 font-medium">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
