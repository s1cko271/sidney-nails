---
import siteData from '../data/site.json';

const googleIcon = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>`;
---
<section class="py-24 md:py-32 bg-[#fafafa] text-brand-charcoal overflow-hidden" id="reviews">
  <div class="max-w-[1400px] mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-20 md:mb-28 reveal">
      <h2 class="font-body text-2xl md:text-3xl font-bold mb-6 tracking-widest uppercase">
        {siteData.reviews.title} {siteData.reviews.titleAccent}
      </h2>
    </div>

    <div class="relative max-w-[1150px] mx-auto">
      <!-- Navigation Arrows -->
      <button id="prevReview" class="absolute -left-3 md:-left-12 top-[45%] -translate-y-1/2 z-20 w-10 h-10 md:w-14 md:h-14 flex items-center justify-center bg-white rounded-full shadow-grounded text-brand-charcoal/30 hover:text-brand-charcoal transition-colors" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 md:w-7 md:h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
      </button>
      
      <button id="nextReview" class="absolute -right-3 md:-right-12 top-[45%] -translate-y-1/2 z-20 w-10 h-10 md:w-14 md:h-14 flex items-center justify-center bg-white rounded-full shadow-grounded text-brand-charcoal/30 hover:text-brand-charcoal transition-colors" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 md:w-7 md:h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
      </button>

      <!-- Carousel Container -->
      <div id="reviewsCarousel" class="flex overflow-x-auto snap-x snap-mandatory gap-6 md:gap-8 pb-12 pt-16 px-4 md:px-8 -mx-4 md:-mx-8 hide-scrollbar scroll-smooth">
        {siteData.reviews.items.map((review) => (
          <div class="snap-center shrink-0 w-[300px] md:w-[350px] relative bg-white rounded-xl shadow-grounded px-6 pb-8 pt-14">
            <!-- Avatar Overlap -->
            <div class="absolute -top-10 left-1/2 -translate-x-1/2">
              <img src={review.avatar} alt={review.name} class="w-20 h-20 rounded-full border-[5px] border-white shadow-sm object-cover bg-gray-100" />
              <div class="absolute bottom-0 right-0 w-6 h-6 bg-white rounded-full shadow-md flex items-center justify-center p-1" set:html={googleIcon}></div>
            </div>
            
            <div class="text-center">
              <h4 class="font-bold text-gray-900 text-base md:text-lg mb-1">{review.name}</h4>
              <p class="text-[0.7rem] md:text-xs text-gray-400 mb-3">{review.date}</p>
              <div class="flex justify-center gap-1 text-[#ffb400] mb-5">
                {'★★★★★'.split('').map(star => <span class="text-xl md:text-2xl leading-none">{star}</span>)}
              </div>
              <div class="review-body flex flex-col items-center">
                <p class="review-text text-gray-700 text-sm leading-relaxed font-light line-clamp-4 transition-all duration-300">
                  {review.text}
                </p>
                {review.text.length > 160 && (
                  <button class="read-more-btn mt-2 text-gray-400 text-[0.8rem] hover:text-brand-charcoal transition-colors">Read more</button>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('reviewsCarousel');
    const prevBtn = document.getElementById('prevReview');
    const nextBtn = document.getElementById('nextReview');

    
    document.querySelectorAll('.read-more-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const textEl = this.previousElementSibling;
        if (textEl.classList.contains('line-clamp-4')) {
          textEl.classList.remove('line-clamp-4');
          this.innerText = 'Show less';
        } else {
          textEl.classList.add('line-clamp-4');
          this.innerText = 'Read more';
        }
      });
    });

    if(carousel && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        // Find gap programmatically or hardcode based on tailwind gap-6/8
        const gap = window.innerWidth < 768 ? 24 : 32; 
        const cardWidth = carousel.firstElementChild.offsetWidth + gap;
        carousel.scrollBy({ left: -cardWidth, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        const gap = window.innerWidth < 768 ? 24 : 32;
        const cardWidth = carousel.firstElementChild.offsetWidth + gap;
        carousel.scrollBy({ left: cardWidth, behavior: 'smooth' });
      });
    }
  });
</script>
