---
import siteData from '../data/site.json';

const googleIcon = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>`;
const featuredReview = siteData.reviews.items[0];
const otherReviews = siteData.reviews.items.slice(1, 5); // Take the next 4
---
<section class="py-24 md:py-32 relative bg-[#fafafa]/85" id="reviews">
  <div class="max-w-[1400px] mx-auto px-6 relative z-10">
    <div class="mb-16 reveal flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div>
        <div class="inline-block text-brand-goldDark text-[0.65rem] font-bold tracking-[0.2em] uppercase mb-4 border border-brand-goldDark/20 px-3 py-1 rounded-full">
          Testimonials
        </div>
        <h2 class="font-display lining-nums text-4xl md:text-5xl font-light text-brand-charcoal">
          {siteData.reviews.title} <span class="font-semibold italic text-brand-gold">{siteData.reviews.titleAccent}</span>
        </h2>
      </div>
      <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(siteData.salon.name + ' ' + siteData.salon.address)}`} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 text-brand-charcoal text-sm font-bold uppercase tracking-widest hover:text-brand-gold transition-colors">
        Read more on Google 
        <span class="w-8 h-8 rounded-full border border-brand-charcoal/20 flex items-center justify-center group-hover:border-brand-gold transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </span>
      </a>
    </div>

    <div class="flex flex-col xl:flex-row gap-8">
      <!-- Featured Review -->
      <div class="w-full xl:w-5/12 reveal">
        <div class="bg-gradient-to-br from-brand-charcoal to-[#0e1d2e] rounded-[3rem] p-10 md:p-14 text-white relative shadow-xl overflow-hidden h-full flex flex-col">
          <div class="absolute -top-4 -right-4 text-brand-gold/10">
            <svg class="w-48 h-48" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          </div>
          <div class="flex gap-1 text-brand-goldLight mb-8">
            {'★★★★★'.split('').map(star => <span class="text-2xl">{star}</span>)}
          </div>
          <p class="text-2xl md:text-3xl leading-relaxed font-light mb-12 relative z-10 flex-grow font-display">
            "{featuredReview.text}"
          </p>
          <div class="flex items-center justify-between mt-auto">
            <div class="flex items-center gap-4">
              <img src={featuredReview.avatar} alt={featuredReview.name} class="w-14 h-14 rounded-full border-[3px] border-white/10 object-cover" loading="lazy" />
              <div>
                <div class="font-bold text-lg">{featuredReview.name}</div>
                <div class="text-white/50 text-xs">{featuredReview.date}</div>
              </div>
            </div>
            <div class="w-8 h-8 opacity-80" set:html={googleIcon}></div>
          </div>
        </div>
      </div>
      
      <!-- Grid Reviews -->
      <div class="w-full xl:w-7/12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 h-full">
          {otherReviews.map(review => (
            <div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-brand-luxury/30 flex flex-col hover:-translate-y-1 transition-transform duration-300 reveal">
              <div class="flex gap-1 text-brand-gold mb-6 text-sm">
                {'★★★★★'.split('').map(star => <span>{star}</span>)}
              </div>
              <p class="text-brand-charcoal/70 text-base leading-relaxed font-light mb-8 flex-grow">
                "{review.text}"
              </p>
              <div class="flex items-center justify-between mt-auto pt-6 border-t border-gray-100">
                <div class="flex items-center gap-3">
                  <img src={review.avatar} alt={review.name} class="w-10 h-10 rounded-full object-cover border border-gray-200" loading="lazy" />
                  <div>
                    <div class="font-bold text-sm text-brand-charcoal">{review.name}</div>
                    <div class="text-[0.65rem] text-brand-charcoal/50 uppercase tracking-wider">{review.date}</div>
                  </div>
                </div>
                <div class="w-5 h-5 opacity-60" set:html={googleIcon}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>


