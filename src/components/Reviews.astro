---
import siteData from '../data/site.json';
---
<section class="py-24 md:py-32 bg-brand-charcoal text-white relative overflow-hidden" id="reviews">
  <!-- Subtle background glow for luxury feel -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[600px] bg-brand-gold/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-20 reveal">
      <div class="inline-block text-brand-goldLight text-xs font-bold tracking-[0.2em] uppercase mb-4">
        {siteData.reviews.sectionTag}
      </div>
      <h2 class="font-display text-4xl md:text-5xl font-light mb-6">
        {siteData.reviews.title} <span class="font-semibold italic text-brand-gold">{siteData.reviews.titleAccent}</span>
      </h2>
      <p class="text-white/60 leading-relaxed font-light text-lg">
        {siteData.reviews.subtitle}
      </p>
    </div>

    <!-- Enlarged, Asymmetrical Vertical Feed Layout for maximum readability -->
    <div class="flex flex-col gap-16 items-center max-w-3xl mx-auto">
      {siteData.reviews.items.map((review, index) => (
        <div class={`w-full rounded-2xl overflow-hidden shadow-2xl transition-all duration-700 motion-safe:hover:scale-[1.03] reveal bg-[#202124] border border-white/10 ${index === 1 ? 'md:translate-x-8' : 'md:-translate-x-8'}`}>
          <img src={review.image} alt="Google Maps Review" class="w-full h-auto block object-cover" />
        </div>
      ))}
    </div>
  </div>
</section>