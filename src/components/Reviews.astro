---
import siteData from '../data/site.json';
---
<section id="reviews" class="py-24 relative bg-white/40 backdrop-blur-md border-t border-white/60">
  <div class="max-w-[1180px] mx-auto px-6 sm:px-8">
    <div class="text-center mb-14 reveal">
      <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-3">
        Client Testimonials
      </div>
      <h2 class="font-display text-4xl md:text-5xl font-normal text-brand-charcoal mb-4">
        Community <em class="italic font-medium text-brand-gold">Love</em>
      </h2>
      <p class="text-slate-600 text-sm md:text-base max-w-lg mx-auto font-light">
        We are proud to serve Sidney, MT. Read what our guests say, or share your own salon experience.
      </p>
    </div>

    <!-- Featured Review Layout -->
    <div class="max-w-3xl mx-auto bg-white/85 backdrop-blur-xl rounded-3xl p-8 md:p-14 mb-10 shadow-[0_12px_40px_rgba(91,155,213,0.15)] border border-white/90 text-center relative reveal card-hover">
      <svg class="w-10 h-10 text-brand-gold/30 mx-auto mb-6" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
      </svg>
      
      <!-- 5 Star Indicator -->
      <div class="flex justify-center gap-1 mb-6 text-brand-gold">
        {[...Array(5)].map(() => (
          <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        ))}
      </div>

      <blockquote class="font-display text-xl md:text-2xl text-slate-700 leading-relaxed mb-6 max-w-2xl mx-auto italic font-normal">
        "{siteData.reviews.items[0]?.text || 'TODO: Real customer review quote to be added upon salon launch in Sidney, MT.'}"
      </blockquote>

      <div class="font-body font-semibold text-xs uppercase tracking-widest text-[#1B3A5C]">
        {siteData.reviews.items[0]?.name || 'TODO: Client Name'}
        <span class="text-slate-400 font-normal lowercase tracking-normal ml-1">&middot; {siteData.reviews.items[0]?.date || 'Sidney, MT'}</span>
      </div>
    </div>

    <!-- Review Invitation Callout -->
    <div class="text-center reveal">
      <a 
        href={siteData.social.googleReviews.startsWith('TODO') ? 'https://maps.app.goo.gl/th34qAzZDDTthUoLA' : siteData.social.googleReviews} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 bg-[#1B3A5C] text-white px-7 py-3 rounded-full text-xs font-semibold uppercase tracking-wider hover:bg-brand-gold hover:text-[#1B3A5C] transition-all duration-300 shadow-sm hover:-translate-y-0.5 active:translate-y-0"
      >
        <span>Leave a Review on Google (Save 5%)</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
