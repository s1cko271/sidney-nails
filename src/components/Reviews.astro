---
import siteData from '../data/site.json';
---
<section id="reviews" class="py-24 bg-brand-cream relative border-t border-brand-offwhite">
  <div class="max-w-[1000px] mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <h2 class="font-display text-4xl md:text-5xl text-brand-charcoal mb-4">
        Client <em class="italic font-medium text-brand-gold">Love</em>
      </h2>
      <p class="text-brand-charcoal/60 text-sm max-w-lg mx-auto">What our community says about Sidney Nails.</p>
    </div>

    <!-- Featured Review -->
    {siteData.reviews.items.length > 0 && (
      <div class="bg-brand-offwhite rounded-3xl p-10 md:p-16 mb-12 shadow-sm text-center relative reveal">
        <svg class="absolute top-8 left-8 md:top-12 md:left-12 w-12 h-12 text-brand-goldLight/30" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
        <div class="flex justify-center gap-1 mb-6">
          {[...Array(5)].map(() => (
            <svg class="w-5 h-5 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
        </div>
        <p class="font-display text-xl md:text-3xl text-brand-charcoal/90 leading-relaxed mb-8 max-w-3xl mx-auto">
          "{siteData.reviews.items[0].text}"
        </p>
        <div class="font-body font-semibold text-sm uppercase tracking-widest text-brand-luxury">
          {siteData.reviews.items[0].name}
        </div>
      </div>
    )}
  </div>
</section>
