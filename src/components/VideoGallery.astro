---
import siteData from '../data/site.json';
---
<section class="py-24 bg-brand-charcoal relative overflow-hidden" id="videos">
  <!-- Subtle background accent -->
  <div class="absolute inset-0 opacity-10" style="background-image: url('/images/marble-bg.jpg'); background-size: cover; background-position: center; mix-blend-mode: overlay;"></div>
  
  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-4">
        Salon in Action
      </div>
      <h2 class="font-display lining-nums text-4xl md:text-5xl font-light text-white mb-4">
        Video <span class="font-semibold italic text-brand-gold">Gallery</span>
      </h2>
      <p class="text-white/70 leading-relaxed font-light text-justify [text-align-last:center]">
        Experience the relaxing atmosphere and precision work of our talented nail technicians.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Video 1 -->
      <div class="relative rounded-2xl overflow-hidden shadow-[0_0_40px_rgba(235,183,52,0.1)] border border-brand-gold/20 aspect-[9/16] bg-black group reveal">
        <video 
          class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500" 
          src="/videos/video1.mp4" 
          muted 
          loop 
          playsinline 
          controls
          preload="metadata"
        ></video>
      </div>

      <!-- Video 2 -->
      <div class="relative rounded-2xl overflow-hidden shadow-[0_0_40px_rgba(235,183,52,0.1)] border border-brand-gold/20 aspect-[9/16] bg-black group reveal" style="transition-delay: 100ms;">
        <video 
          class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500" 
          src="/videos/video2.mp4" 
          muted 
          loop 
          playsinline 
          controls
          preload="metadata"
        ></video>
      </div>

      <!-- Video 3 -->
      <div class="relative rounded-2xl overflow-hidden shadow-[0_0_40px_rgba(235,183,52,0.1)] border border-brand-gold/20 aspect-[9/16] bg-black group reveal" style="transition-delay: 200ms;">
        <video 
          class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500" 
          src="/videos/video3.mp4" 
          muted 
          loop 
          playsinline 
          controls
          preload="metadata"
        ></video>
      </div>
    </div>
  </div>
</section>
