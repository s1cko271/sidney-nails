---
import siteData from '../data/site.json';

const videos = [
  { id: 'v1', src: '/videos/video1.mp4' },
  { id: 'v2', src: '/videos/video2.mp4' },
  { id: 'v3', src: '/videos/video3.mp4' },
];
---
<section class="py-24 bg-brand-charcoal relative overflow-hidden" id="videos">
  <!-- Subtle background accent -->
  <div class="absolute inset-0 opacity-10" style="background-image: url('/images/marble-bg.jpg'); background-size: cover; background-position: center; mix-blend-mode: overlay;"></div>
  
  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-4">
        Salon in Action
      </div>
      <h2 class="font-display lining-nums text-4xl md:text-5xl font-light text-white mb-4">
        Video <span class="font-semibold italic text-brand-gold">Gallery</span>
      </h2>
      <p class="text-white/70 leading-relaxed font-light text-justify [text-align-last:center]">
        Experience the relaxing atmosphere and precision work of our talented nail technicians.
      </p>
    </div>

    <!-- Vertical scrolling layout -->
    <div class="flex flex-col items-center gap-16 md:gap-24">
      {videos.map((vid, index) => (
        <div 
          class="relative w-full max-w-sm rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-brand-gold/10 aspect-[9/16] bg-brand-charcoal reveal transform-gpu transition-all duration-700 hover:shadow-[0_20px_60px_rgba(212,175,55,0.15)] hover:border-brand-gold/30" 
          data-video-wrapper
        >
          <video 
            class="w-full h-full object-cover" 
            src={vid.src} 
            muted 
            loop 
            playsinline 
            preload="metadata"
            data-auto-play-video
          ></video>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const videos = document.querySelectorAll('[data-auto-play-video]');
    
    // Play video when 50% of it is in the viewport, pause when it leaves
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          // Play automatically
          video.play().catch(e => console.log('Autoplay prevented:', e));
        } else {
          // Pause to save resources
          video.pause();
        }
      });
    }, { 
      threshold: 0.5 
    });

    videos.forEach(v => observer.observe(v));
  });
</script>
