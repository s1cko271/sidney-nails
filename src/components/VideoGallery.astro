---
import siteData from '../data/site.json';
---
<section class="py-24 bg-brand-charcoal text-brand-cream relative">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 reveal">
      <div>
        <h2 class="font-display text-4xl md:text-5xl mb-4">
          Salon in <em class="italic font-medium text-brand-gold">Action</em>
        </h2>
        <p class="text-white/60 text-sm max-w-sm">Experience the relaxing atmosphere and precision craftsmanship at Sidney Nails.</p>
      </div>
    </div>

    <!-- 3-Video Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal">
      {['/videos/video1.mp4', '/videos/video2.mp4', '/videos/video3.mp4'].map(vid => (
        <div class="relative aspect-[9/16] rounded-2xl overflow-hidden bg-black shadow-xl group">
          <video class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" autoplay loop muted playsinline>
            <source src={vid} type="video/mp4" />
          </video>
          <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors duration-500"></div>
        </div>
      ))}
    </div>
  </div>
</section>
