---
import siteData from '../data/site.json';

const videos = [
  { src: '/videos/video1.mp4', label: 'Precision Manicure Artistry' },
  { src: '/videos/video2.mp4', label: 'Relaxing Spa Pedicure' },
  { src: '/videos/video3.mp4', label: 'Artistic Nail Design' },
];
---
<section class="py-24 bg-[#1B3A5C] text-white relative overflow-hidden" id="videos">
  <div class="max-w-[1180px] mx-auto px-6 sm:px-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-14 reveal gap-6">
      <div>
        <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-3">
          Behind the Scenes
        </div>
        <h2 class="font-display text-4xl md:text-5xl font-normal text-white mb-3">
          Salon in <em class="italic font-medium text-brand-gold">Action</em>
        </h2>
        <p class="text-white/75 text-sm md:text-base max-w-md font-light leading-relaxed">
          Watch our technicians craft meticulous nail sets and create a relaxing, soothing environment for every client.
        </p>
      </div>

      <div class="hidden md:flex items-center gap-2 text-xs text-white/60 tracking-wider uppercase font-semibold">
        <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse"></span>
        Live in Salon
      </div>
    </div>

    <!-- 3-Video Grid (9/16 vertical reels) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {videos.map((vid, idx) => (
        <div 
          class="relative aspect-[9/16] rounded-2xl overflow-hidden bg-black/40 shadow-xl border border-white/10 group reveal"
          style={`--reveal-delay: ${idx * 100}ms;`}
        >
          <video 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
            autoplay 
            loop 
            muted 
            playsinline
            preload="metadata"
            aria-label={vid.label}
          >
            <source src={vid.src} type="video/mp4" />
          </video>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-black/20 pointer-events-none"></div>
          
          <!-- Subtle Center Play/Reel Indicator Pill -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-lg transform group-hover:scale-110 transition-transform duration-300">
              <svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>

          <div class="absolute bottom-4 left-4 right-4 pointer-events-none flex items-center justify-between">
            <span class="text-xs font-medium text-white/95 drop-shadow-sm">{vid.label}</span>
            <span class="text-[0.65rem] font-mono uppercase tracking-wider text-white/60 bg-white/10 px-2 py-0.5 rounded-full backdrop-blur-sm">HD</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
