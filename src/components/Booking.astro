---
import siteData from '../data/site.json';
---
<section class="py-24 md:py-32 bg-brand-cream border-t border-brand-charcoal/5" id="booking">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">
      
      <!-- Info Column -->
      <div class="reveal">
        <div class="inline-block text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase mb-4">
          {siteData.booking.sectionTag}
        </div>
        <h2 class="font-display text-4xl md:text-5xl font-light text-brand-charcoal mb-4">
          {siteData.booking.title} <span class="font-semibold italic text-brand-gold">{siteData.booking.titleAccent}</span>
        </h2>
        <p class="text-brand-charcoal/60 leading-relaxed font-light mb-10">
          {siteData.booking.subtitle}
        </p>

        <!-- Contact Cards -->
        <div class="flex flex-col gap-4 mb-8">
          <div class="bg-white p-6 rounded-2xl border border-brand-charcoal/5 flex items-start gap-5 shadow-soft hover:shadow-xl transition-shadow duration-300">
            <div class="w-12 h-12 rounded-full bg-brand-cream border border-brand-gold/30 flex items-center justify-center text-brand-gold flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
            </div>
            <div>
              <div class="text-[0.65rem] font-bold tracking-[0.2em] uppercase text-brand-charcoal/40 mb-1">Address</div>
              <div class="text-brand-charcoal font-medium text-sm leading-relaxed">{siteData.salon.fullAddress}</div>
            </div>
          </div>
          
          <div class="bg-white p-6 rounded-2xl border border-brand-charcoal/5 flex items-start gap-5 shadow-soft hover:shadow-xl transition-shadow duration-300">
            <div class="w-12 h-12 rounded-full bg-brand-cream border border-brand-gold/30 flex items-center justify-center text-brand-gold flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.439-4.14-7.035-7.035l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
            </div>
            <div>
              <div class="text-[0.65rem] font-bold tracking-[0.2em] uppercase text-brand-charcoal/40 mb-1">Phone</div>
              <a href={`tel:${siteData.salon.phoneRaw}`} class="text-brand-charcoal font-medium text-sm hover:text-brand-gold transition-colors block">{siteData.salon.phone}</a>
            </div>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-brand-charcoal/5 flex items-start gap-5 shadow-soft hover:shadow-xl transition-shadow duration-300">
            <div class="w-12 h-12 rounded-full bg-brand-cream border border-brand-gold/30 flex items-center justify-center text-brand-gold flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            </div>
            <div>
              <div class="text-[0.65rem] font-bold tracking-[0.2em] uppercase text-brand-charcoal/40 mb-1">Hours</div>
              <div class="text-brand-charcoal font-medium text-sm leading-relaxed">{siteData.hours.line1}<br/>{siteData.hours.line2}</div>
            </div>
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden border border-brand-charcoal/10 shadow-soft">
          <iframe src={siteData.map.embedUrl} width="100%" height="220" style="border:0;display:block" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <a href={siteData.map.directionsUrl} target="_blank" class="inline-flex items-center gap-2 mt-4 text-brand-goldDark text-sm font-semibold hover:text-brand-charcoal transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
          Open in Google Maps
        </a>
      </div>

      <!-- Booking Form Column -->
      <div class="bg-brand-charcoal rounded-3xl border border-brand-gold/20 shadow-2xl overflow-hidden flex flex-col reveal sticky top-32 relative">
        <!-- Accent lines -->
        <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-brand-goldDark via-brand-goldLight to-brand-goldDark"></div>
        <div class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-brand-goldDark via-brand-goldLight to-brand-goldDark"></div>
        
        <div class="p-10 md:px-12 md:pt-12 md:pb-8 text-center relative z-10 border-b border-white/5">
          <h3 class="font-display text-3xl font-light text-white mb-3">{siteData.booking.formTitle}</h3>
          <p class="text-brand-goldLight/80 font-light text-sm tracking-wide">Book your appointment securely via Square.</p>
        </div>
        
        <div class="flex-grow min-h-[400px] relative z-10 bg-brand-charcoal">
          {siteData.booking.bookingUrl === "REPLACE_WITH_SQUARE_BOOKING_LINK" ? (
            <div class="p-12 text-center h-full flex flex-col items-center justify-center">
              <div class="w-20 h-20 rounded-full border border-brand-gold/30 flex items-center justify-center text-brand-gold mb-6 shadow-[0_0_30px_rgba(212,175,55,0.1)] bg-brand-gold/5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
              </div>
              <p class="mb-8 text-brand-cream/80 font-light"><strong class="text-brand-gold font-normal tracking-wider block mb-2 text-lg">Booking System Ready</strong>Your Square Appointments widget will appear here once linked.</p>
              <a href="#" class="inline-block bg-transparent border-2 border-brand-gold text-brand-gold px-8 py-3 rounded-full font-bold text-sm uppercase tracking-widest hover:bg-brand-gold hover:text-brand-charcoal transition-all shadow-[0_0_15px_rgba(212,175,55,0.2)]">
                {siteData.booking.formButtonText}
              </a>
            </div>
          ) : (
             <div class="p-2">
                <iframe 
                  src={siteData.booking.bookingUrl} 
                  style="width:100%; height: 500px; border:none; display:block;" 
                  title="Square Booking Widget">
                </iframe>
            </div>
          )}
        </div>
      </div>

    </div>
  </div>
</section>

