---
import siteData from '../data/site.json';
---
<section class="py-24 bg-brand-cream border-t border-slate-200/60" id="booking">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      
      <!-- Salon Details & Map -->
      <div class="reveal">
        <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-3">
          Location &amp; Hours
        </div>
        <h2 class="font-display text-4xl md:text-5xl font-normal text-brand-charcoal mb-4">
          Visit Us in <em class="italic font-medium text-brand-gold">Sidney, MT</em>
        </h2>
        <p class="text-slate-600 leading-relaxed font-light mb-8 text-sm md:text-base">
          Conveniently located at 422 N Central Ave in the heart of Sidney. Walk-ins are always warmly welcomed, and appointments guarantee your dedicated time.
        </p>

        <!-- Information Cards -->
        <div class="flex flex-col gap-3.5 mb-8">
          <!-- Address Card -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200/80 flex items-start gap-4 shadow-sm">
            <div class="w-11 h-11 rounded-full bg-brand-offwhite border border-slate-200 flex items-center justify-center text-brand-gold shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
            </div>
            <div>
              <div class="text-[0.65rem] font-bold tracking-[0.2em] uppercase text-slate-400 mb-0.5">Address</div>
              <div class="text-brand-charcoal font-medium text-sm">{siteData.salon.fullAddress}</div>
            </div>
          </div>
          
          <!-- Phone Card -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200/80 flex items-start gap-4 shadow-sm">
            <div class="w-11 h-11 rounded-full bg-brand-offwhite border border-slate-200 flex items-center justify-center text-brand-gold shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.439-4.14-7.035-7.035l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
            </div>
            <div>
              <div class="text-[0.65rem] font-bold tracking-[0.2em] uppercase text-slate-400 mb-0.5">Phone</div>
              <a href={`tel:${siteData.salon.phoneRaw}`} class="text-brand-charcoal font-medium text-sm hover:text-brand-gold transition-colors block">{siteData.salon.phone}</a>
            </div>
          </div>

          <!-- Hours Card -->
          <div class="bg-white p-5 rounded-2xl border border-slate-200/80 flex items-start gap-4 shadow-sm">
            <div class="w-11 h-11 rounded-full bg-brand-offwhite border border-slate-200 flex items-center justify-center text-brand-gold shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            </div>
            <div>
              <div class="text-[0.65rem] font-bold tracking-[0.2em] uppercase text-slate-400 mb-0.5">Hours</div>
              <div class="text-brand-charcoal font-medium text-sm leading-relaxed">
                Mon – Sat: 9:00 AM – 7:00 PM<br/>
                Sunday: Closed
              </div>
            </div>
          </div>
        </div>

        <!-- Google Map Embed -->
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-white">
          <iframe 
            src={siteData.map.embedUrl && !siteData.map.embedUrl.startsWith('TODO') ? siteData.map.embedUrl : "https://maps.google.com/maps?q=422+N+Central+Ave,+Sidney,+MT+59270&t=&z=16&ie=UTF8&iwloc=&output=embed"} 
            width="100%" 
            height="240" 
            style="border:0;display:block" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Sidney Nails Map Location"
          ></iframe>
        </div>
        <a href={siteData.map.directionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-4 text-brand-luxury text-sm font-semibold hover:text-brand-gold transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
          Open in Google Maps
        </a>
      </div>

      <!-- Action Card (Rich Navy #1B3A5C) -->
      <div class="bg-[#1B3A5C] text-white rounded-3xl border border-[#2D5A8B] shadow-xl p-8 md:p-12 text-center reveal sticky top-28">
        <div class="w-16 h-16 rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-brand-gold mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-7 h-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
          </svg>
        </div>

        <h3 class="font-display text-3xl font-medium text-white mb-3">Reserve Your Visit</h3>
        <p class="text-white/75 font-light text-sm leading-relaxed mb-8 max-w-sm mx-auto">
          Contact our team directly to book your appointment or inquire about custom nail art and services.
        </p>
        
        <div class="flex flex-col gap-4 max-w-xs mx-auto">
          <!-- Direct Call Button -->
          <a href={`tel:${siteData.salon.phoneRaw}`} class="w-full flex items-center justify-center gap-3 bg-brand-gold text-brand-luxury px-6 py-4 rounded-full font-bold text-xs uppercase tracking-widest hover:bg-white transition-all shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.439-4.14-7.035-7.035l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            Call {siteData.salon.phone}
          </a>

          <!-- Messenger / Message Button -->
          <a href={siteData.booking.messengerUrl && !siteData.booking.messengerUrl.startsWith('TODO') ? siteData.booking.messengerUrl : `tel:${siteData.salon.phoneRaw}`} target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center gap-3 bg-white/10 border border-white/20 text-white px-6 py-4 rounded-full font-bold text-xs uppercase tracking-widest hover:bg-white hover:text-brand-luxury transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a.75.75 0 0 1-.974-.94 4.52 4.52 0 0 0 .78-2.613A8.163 8.163 0 0 1 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
            </svg>
            Message On Messenger
          </a>
        </div>

        <p class="text-xs text-white/50 mt-6 font-light">
          Open Mon – Sat 9:00 AM – 7:00 PM &middot; Sunday Closed
        </p>
      </div>

    </div>
  </div>
</section>
