---
import siteData from '../data/site.json';

const beautyImages = [
  {
    image: '/images/beauty/eyelash-extensions.jpg',
    caption: 'Lash Extensions'
  },
  {
    image: '/images/beauty/microblading-brow.jpg',
    caption: 'Eyebrow Microblading'
  },
  {
    image: '/images/beauty/brow-waxing.jpg',
    caption: 'Eyebrow Waxing'
  },
  {
    image: '/images/beauty/volume-lashes.jpg',
    caption: 'Volume Lashes'
  },
  {
    image: '/images/beauty/body-waxing.jpg',
    caption: 'Body Waxing'
  },
  {
    image: '/images/beauty/eyebrow-tattoo.jpg',
    caption: 'Ombre Powder Brows'
  },
  {
    image: '/images/beauty/lash-artistry.jpg',
    caption: 'Couture Lashes'
  },
  {
    image: '/images/beauty/brow-lamination.jpg',
    caption: 'Brow Lamination'
  },
  {
    image: '/images/beauty/facial-rejuvenation.jpg',
    caption: 'Facial Care'
  },
  {
    image: '/images/beauty/lash-lift.jpg',
    caption: 'Lash Lift & Tint'
  },
  {
    image: '/images/beauty/brow-sculpting.jpg',
    caption: 'Brow Sculpting'
  },
  {
    image: '/images/beauty/skincare-serum.jpg',
    caption: 'Aesthetic Skincare'
  }
];

const messengerUrl = siteData.booking?.messengerUrl || 'https://m.me/sidneynailsmontana';
---

<section class="py-24 relative bg-white/70 backdrop-blur-md overflow-hidden border-t border-slate-200/80" id="beauty">
  <!-- Subtle ambient glow -->
  <div class="absolute top-1/3 -left-32 w-96 h-96 bg-sky-200/30 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/3 -right-32 w-96 h-96 bg-brand-light-blue/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <!-- Header: Eyebrow pill + Title + Diamond divider -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-flex items-center justify-center px-4 py-1.5 rounded-full border border-sky-300 bg-sky-50 text-sky-800 text-[10px] sm:text-[11px] font-bold tracking-[0.25em] uppercase mb-4 shadow-sm">
        WAXING &bull; LASHES &bull; BROWS
      </div>
      <h2 class="font-display lining-nums text-4xl md:text-5xl font-normal text-brand-charcoal mb-4 tracking-tight drop-shadow-sm">
        Lashes, Brows &amp; <span class="font-normal italic text-sky-600">Waxing</span>
      </h2>
      <div class="flex items-center justify-center gap-3 opacity-70 mt-4" aria-hidden="true">
        <span class="w-12 h-px bg-gradient-to-r from-transparent to-sky-400/60"></span>
        <span class="w-1.5 h-1.5 rotate-45 border border-sky-400 bg-sky-100"></span>
        <span class="w-12 h-px bg-gradient-to-l from-transparent to-sky-400/60"></span>
      </div>
    </div>
    
    <!-- Clean Image Masonry Grid (Matching Gallery shape & style) -->
    <div class="columns-2 md:columns-3 lg:columns-4 gap-2 md:gap-3 space-y-2 md:space-y-3">
      {beautyImages.map((item, index) => (
        <div 
          class="group relative overflow-hidden rounded-xl cursor-pointer reveal border border-slate-200/90 hover:border-sky-400 bg-white shadow-md hover:shadow-xl transition-all duration-500 break-inside-avoid transform-gpu"
          style={`--reveal-delay: ${(index % 4) * 80}ms;`}
        >
          <img 
            class="w-full h-auto block transition-transform duration-700 group-hover:scale-105" 
            src={item.image} 
            alt={item.caption} 
            loading="lazy" 
          />
        </div>
      ))}
    </div>

    <!-- Booking / Messenger link at bottom -->
    <div class="text-center mt-12 reveal">
      <a 
        href={messengerUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-sky-700 border-b border-sky-400 pb-1 hover:text-brand-navy hover:border-brand-navy transition-colors"
      >
        Book Appointment On Messenger &rarr;
      </a>
    </div>
  </div>
</section>
