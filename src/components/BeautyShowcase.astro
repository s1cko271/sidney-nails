---
import siteData from '../data/site.json';

const items = [
  {
    image: '/images/beauty/waxing-sugar-care.jpg',
    caption: 'Velvet Leg & Body Sugaring'
  },
  {
    image: '/images/beauty/eyelash-heart-artistry.jpg',
    caption: 'Bespoke Curl & Lift Artistry'
  },
  {
    image: '/images/beauty/facial-radiance-treatment.jpg',
    caption: 'Dewy Radiance Facial Therapy'
  },
  {
    image: '/images/beauty/eyelash-isolation-craft.jpg',
    caption: 'Master Single-Lash Isolation'
  },
  {
    image: '/images/beauty/botanical-soothing-elixir.jpg',
    caption: 'Botanical Soothing Elixir'
  },
  {
    image: '/images/beauty/eyelash-feather-styling.jpg',
    caption: 'Lash Feathering & Protective Seal'
  }
];

const messengerUrl = siteData.booking?.messengerUrl || 'https://m.me/sidneynailsmontana';
---

<section class="py-24 relative bg-white/45 backdrop-blur-md border-t border-sky-400/20" id="beauty">
  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <!-- Header: Pill + Title + Dot Divider -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-sky-800 text-xs font-bold tracking-[0.2em] uppercase mb-4 px-4 py-1 rounded-full border border-sky-300 bg-sky-50 shadow-sm">
        Waxing & Lashes
      </div>
      <h2 class="font-display lining-nums text-4xl md:text-5xl font-light text-brand-charcoal mb-3">
        Silk Lashes & <span class="font-semibold italic text-sky-600">Gentle Waxing</span>
      </h2>
      <div class="w-1.5 h-1.5 rounded-full bg-sky-500 mx-auto mt-4"></div>
    </div>
    
    <!-- Clean Photo Masonry Display -->
    <div class="columns-2 md:columns-3 gap-3 md:gap-4">
      {items.map((item) => (
        <div class="group relative overflow-hidden rounded-xl cursor-pointer reveal border border-sky-400/60 hover:border-sky-500 transition-all duration-500 break-inside-avoid mb-3 md:mb-4 transform-gpu shadow-sm hover:shadow-glow">
          <img 
            class="w-full h-auto block object-cover transition-transform duration-700 group-hover:scale-105" 
            src={item.image} 
            alt={item.caption || "Waxing and lash artistry"} 
            loading="lazy" 
          />
        </div>
      ))}
    </div>

    <!-- Subtle Footer Link -->
    <div class="text-center mt-12 reveal">
      <a 
        href={messengerUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 text-[0.7rem] font-bold tracking-[0.2em] uppercase text-sky-700 hover:text-brand-charcoal border-b border-sky-400 pb-1 transition-colors"
      >
        Book Appointment &rarr;
      </a>
    </div>
  </div>
</section>
