---
import siteData from '../data/site.json';
---
<section id="pricing" class="py-24 relative bg-white/50 backdrop-blur-md">
  <div class="max-w-[1180px] mx-auto px-6 sm:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14 reveal">
      <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-3">
        Full Treatment Menu
      </div>
      <h2 class="font-display text-4xl md:text-5xl font-normal text-brand-charcoal mb-4">
        Services &amp; <em class="italic font-medium text-brand-gold">Menu</em>
      </h2>
      <p class="text-slate-600 text-sm md:text-base leading-relaxed font-light">
        Explore our comprehensive service menu. Whether you are stopping in for a quick polish change or unwinding with a royal pedicure, we tailor every detail to your comfort.
      </p>
    </div>

    <!-- Accessible Tabs Header -->
    <div class="flex overflow-x-auto justify-start md:justify-center gap-2.5 pb-3 md:pb-0 mb-12 scrollbar-none snap-x reveal" role="tablist" aria-label="Service Menu Categories">
      {siteData.pricing.categories.map((cat, idx) => (
        <button 
          type="button"
          role="tab"
          id={`tab-btn-${idx}`}
          aria-selected={idx === 0 ? "true" : "false"}
          aria-controls={`tab-panel-${idx}`}
          tabindex={idx === 0 ? "0" : "-1"}
          class={`menu-tab shrink-0 snap-start px-6 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 border focus:outline-none focus:ring-2 focus:ring-brand-gold ${idx === 0 ? 'bg-[#1B3A5C] text-white border-[#1B3A5C] shadow-md' : 'bg-white/80 backdrop-blur-md text-slate-700 border-white/80 shadow-sm hover:border-[#1B3A5C] hover:text-[#1B3A5C]'}`}
          data-target={`tab-panel-${idx}`}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Tab Panels Container -->
    <div class="relative min-h-[380px]">
      {siteData.pricing.categories.map((cat, idx) => (
        <div 
          id={`tab-panel-${idx}`} 
          role="tabpanel"
          aria-labelledby={`tab-btn-${idx}`}
          class={`menu-content transition-all duration-300 ${idx === 0 ? 'block opacity-100' : 'hidden opacity-0'}`}
        >
          <div class="mb-10 text-center max-w-xl mx-auto">
            <p class="text-slate-500 italic text-sm font-light">{cat.description}</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
            {cat.items.map((item, itemIdx) => {
              // If category has only 2 items (like Manicure), don't force span-2 on popular item so they balance side-by-side
              const isOnlyTwo = cat.items.length === 2;
              const shouldSpanTwo = item.popular && !isOnlyTwo;
              const isOdd = itemIdx % 2 !== 0;

              return (
                <div 
                  class={`rounded-2xl p-6 md:p-8 border transition-all duration-300 flex flex-col justify-between card-hover reveal ${
                    item.popular 
                      ? `bg-[#1B3A5C]/95 backdrop-blur-md text-white border-[#2D5A8B] shadow-xl ${shouldSpanTwo ? 'md:col-span-2 lg:col-span-2' : 'col-span-1'} hover:-translate-y-1` 
                      : isOdd
                        ? 'bg-[#EBF3FB]/90 backdrop-blur-lg text-brand-charcoal border-sky-200/80 shadow-[0_8px_30px_rgba(91,155,213,0.12)] hover:shadow-[0_16px_36px_rgba(27,58,92,0.16)] hover:-translate-y-1 hover:border-brand-gold/60'
                        : 'bg-white/95 backdrop-blur-lg text-brand-charcoal border-slate-200/80 shadow-[0_8px_30px_rgba(91,155,213,0.1)] hover:shadow-[0_16px_36px_rgba(27,58,92,0.14)] hover:-translate-y-1 hover:border-brand-gold/50'
                  }`}
                  style={`--reveal-delay: ${(itemIdx % 4) * 80}ms;`}
                >
                  <div>
                    <div class="flex justify-between items-start gap-4 mb-2">
                      <div class="flex items-center gap-3">
                        <h3 class={`font-display text-xl md:text-2xl font-medium ${item.popular ? 'text-white' : 'text-brand-charcoal'}`}>
                          {item.name}
                        </h3>
                        {item.popular && (
                          <span class="inline-block px-3 py-1 bg-brand-gold text-[#1B3A5C] text-[0.65rem] font-bold uppercase tracking-widest rounded-full shadow-sm">
                            Most Popular
                          </span>
                        )}
                      </div>
                      
                      <!-- Price Tag -->
                      <div class="shrink-0 text-right">
                        {item.price === 'TODO' || item.price === 'TODO_PRICE' ? (
                          <span class={`text-xs font-mono font-medium px-2.5 py-1 rounded-md border ${
                            item.popular ? 'bg-white/10 text-white/90 border-white/20' : 'bg-slate-200/70 text-slate-600 border-slate-300'
                          }`}>
                            TODO (Price)
                          </span>
                        ) : (
                          <span class={`font-display text-2xl font-semibold ${item.popular ? 'text-brand-gold' : 'text-[#1B3A5C]'}`}>
                            {item.price}
                          </span>
                        )}
                      </div>
                    </div>

                    <p class={`text-sm leading-relaxed font-light mt-2 pr-6 ${item.popular ? 'text-white/80' : 'text-slate-600'}`}>
                      {item.description}
                    </p>
                  </div>

                  <div class="pt-6 mt-4 border-t border-current/10 flex justify-between items-center text-xs">
                    <span class={item.popular ? 'text-white/60 font-light' : 'text-slate-400 font-light'}>
                      Walk-ins &amp; Appointments
                    </span>
                    <a href="/#booking" class={`font-semibold uppercase tracking-wider transition-colors ${
                      item.popular ? 'text-brand-gold hover:text-white' : 'text-[#1B3A5C] hover:text-brand-gold'
                    }`}>
                      Book &rarr;
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Booking CTA Bar - Distinct Navy styling with Gold CTA so it never clashes as a plain white box -->
    <div class="mt-14 p-6 md:p-8 bg-[#1B3A5C] text-white rounded-2xl border border-[#2D5A8B] shadow-xl text-center flex flex-col sm:flex-row items-center justify-between gap-4 reveal">
      <div class="text-left">
        <h4 class="font-display text-xl font-medium text-white">Have a specific design or bridal party?</h4>
        <p class="text-xs text-white/75 font-light mt-0.5">Call our salon concierge to discuss custom nail art, tap gel enhancements, or group bookings.</p>
      </div>
      <a href={`tel:${siteData.salon.phoneRaw}`} class="shrink-0 bg-brand-gold text-[#1B3A5C] hover:bg-white px-7 py-3 rounded-full font-bold text-xs uppercase tracking-wider transition-all duration-300 shadow-md hover:-translate-y-0.5 active:translate-y-0">
        Call {siteData.salon.phone}
      </a>
    </div>
  </div>
</section>

<script is:inline>
  function initMenuTabs() {
    const tabs = document.querySelectorAll('.menu-tab');
    const contents = document.querySelectorAll('.menu-content');
    if (!tabs.length) return;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // Reset all tabs
        tabs.forEach(t => {
          t.classList.remove('bg-[#1B3A5C]', 'text-white', 'border-[#1B3A5C]', 'shadow-md');
          t.classList.add('bg-white/80', 'backdrop-blur-md', 'text-slate-700', 'border-white/80', 'shadow-sm');
          t.setAttribute('aria-selected', 'false');
          t.setAttribute('tabindex', '-1');
        });

        // Activate clicked tab
        tab.classList.remove('bg-white/80', 'backdrop-blur-md', 'text-slate-700', 'border-white/80', 'shadow-sm');
        tab.classList.add('bg-[#1B3A5C]', 'text-white', 'border-[#1B3A5C]', 'shadow-md');
        tab.setAttribute('aria-selected', 'true');
        tab.setAttribute('tabindex', '0');

        // Hide all panels
        contents.forEach(c => {
          c.classList.add('hidden', 'opacity-0');
          c.classList.remove('block', 'opacity-100');
        });

        // Show matching panel
        const targetId = tab.getAttribute('data-target');
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.classList.remove('hidden');
          const tabCards = targetEl.querySelectorAll('.reveal, .reveal-scale');
          tabCards.forEach((c, cIdx) => {
            c.classList.remove('is-revealed');
            c.style.setProperty('--reveal-delay', `${(cIdx % 4) * 80}ms`);
            setTimeout(() => c.classList.add('is-revealed'), 40);
          });
          setTimeout(() => {
            targetEl.classList.remove('opacity-0');
            targetEl.classList.add('block', 'opacity-100');
          }, 30);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMenuTabs);
  } else {
    initMenuTabs();
  }
  document.addEventListener('astro:page-load', initMenuTabs);
</script>
