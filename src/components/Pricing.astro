---
import siteData from '../data/site.json';
---
<section id="pricing" class="py-24 bg-brand-cream relative">
  <div class="max-w-[1000px] mx-auto px-6">
    <div class="text-center mb-16 reveal">
      <h2 class="font-display text-4xl md:text-5xl text-brand-charcoal mb-4">
        Our <em class="italic font-medium text-brand-gold">Menu</em>
      </h2>
      <p class="text-brand-charcoal/60 text-sm max-w-lg mx-auto">Explore our curated selection of treatments designed to relax and rejuvenate.</p>
    </div>

    <!-- Tabs Header -->
    <div class="flex flex-wrap justify-center gap-2 md:gap-4 mb-12 reveal">
      {siteData.pricing.categories.map((cat, idx) => (
        <button 
          class={`menu-tab px-6 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 border ${idx === 0 ? 'bg-brand-luxury text-brand-cream border-brand-luxury' : 'bg-transparent text-brand-charcoal/60 border-brand-charcoal/10 hover:border-brand-luxury hover:text-brand-luxury'}`}
          data-target={`tab-${idx}`}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Tabs Content -->
    <div class="relative min-h-[400px] reveal">
      {siteData.pricing.categories.map((cat, idx) => (
        <div id={`tab-${idx}`} class={`menu-content transition-all duration-500 ${idx === 0 ? 'block opacity-100' : 'hidden opacity-0'}`}>
          <div class="mb-10 text-center">
            <p class="text-brand-charcoal/70 italic text-sm">{cat.description}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
            {cat.items.map(item => (
              <div class="relative group">
                <div class="flex justify-between items-baseline mb-2">
                  <h3 class="font-display text-xl text-brand-charcoal group-hover:text-brand-gold transition-colors">{item.name} {item.popular && <span class="ml-2 inline-block px-2 py-0.5 bg-brand-luxury text-brand-cream text-[0.6rem] uppercase tracking-widest rounded-sm align-middle">Popular</span>}</h3>
                  <div class="flex-grow border-b border-dotted border-brand-charcoal/20 mx-4 relative top-[-4px]"></div>
                  <span class="font-display text-xl font-medium text-brand-luxury">{item.price}</span>
                </div>
                <p class="text-brand-charcoal/50 text-xs leading-relaxed pr-8">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.menu-tab');
    const contents = document.querySelectorAll('.menu-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // Reset tabs
        tabs.forEach(t => {
          t.classList.remove('bg-brand-luxury', 'text-brand-cream', 'border-brand-luxury');
          t.classList.add('bg-transparent', 'text-brand-charcoal/60', 'border-brand-charcoal/10');
        });
        // Activate current tab
        tab.classList.remove('bg-transparent', 'text-brand-charcoal/60', 'border-brand-charcoal/10');
        tab.classList.add('bg-brand-luxury', 'text-brand-cream', 'border-brand-luxury');

        // Hide all content
        contents.forEach(c => {
          c.classList.add('hidden', 'opacity-0');
          c.classList.remove('block', 'opacity-100');
        });

        // Show target content
        const target = document.getElementById(tab.getAttribute('data-target'));
        if (target) {
          target.classList.remove('hidden');
          // small delay for transition
          setTimeout(() => {
            target.classList.remove('opacity-0');
            target.classList.add('block', 'opacity-100');
          }, 50);
        }
      });
    });
  });
</script>
