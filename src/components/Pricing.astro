---
import siteData from '../data/site.json';
const menu = siteData.pricing.menu;
---
<section class="py-24 md:py-32 bg-brand-offwhite relative overflow-hidden" id="pricing">
  <div class="max-w-[1240px] mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase mb-4">
        {siteData.pricing.sectionTag}
      </div>
      <h2 class="font-display lining-nums text-4xl md:text-5xl font-light text-brand-charcoal mb-4">
        {siteData.pricing.title} <span class="font-semibold italic text-brand-gold">{siteData.pricing.titleAccent}</span>
      </h2>
      <p class="text-brand-charcoal/60 leading-relaxed font-light text-justify [text-align-last:center]">
        {siteData.pricing.subtitle}
      </p>
      <div class="flex items-center justify-center gap-3 mt-8 opacity-70" aria-hidden="true">
        <span class="w-12 h-px bg-brand-gold"></span>
        <span class="text-brand-gold text-xs animate-spin-slow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z"/></svg></span>
        <span class="w-12 h-px bg-brand-gold"></span>
      </div>
    </div>

    <!-- 3 Featured Highlight Packages -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch mb-24">
      {siteData.pricing.packages.map(pkg => (
        <div class:list={[
          "relative rounded-3xl p-8 lg:p-10 transition-all duration-500 reveal flex flex-col",
          pkg.featured 
            ? 'bg-black/95 text-white shadow-[0_20px_40px_rgba(0,0,0,0.25)] border border-brand-gold/30 hover:border-brand-gold/60 hover:-translate-y-2' 
            : 'bg-white text-brand-charcoal shadow-xl border border-gray-100 hover:border-brand-gold/30 hover:-translate-y-2 rounded-2xl'
        ]}>
          
          <div class="flex-grow">
            {pkg.featured && pkg.featuredLabel && (
              <div class="mb-4">
                <span class="inline-block bg-brand-gold text-brand-charcoal text-[0.65rem] font-bold uppercase tracking-[0.2em] py-1.5 px-3 rounded-sm">
                  {pkg.featuredLabel}
                </span>
              </div>
            )}
            
            <div class={`text-[0.75rem] font-bold tracking-[0.15em] uppercase mb-4 ${pkg.featured ? 'text-brand-goldLight' : 'text-brand-charcoal/50'}`}>
              {pkg.name}
            </div>
            
            <div class="mb-1 flex items-baseline gap-2">
              <span class={`font-display lining-nums text-5xl font-bold tracking-tight ${pkg.featured ? 'text-brand-goldLight' : 'text-brand-charcoal'}`}>{pkg.price}</span>
            </div>
            <div class={`text-xs mb-6 font-medium ${pkg.featured ? 'text-white/60' : 'text-brand-charcoal/50'}`}>
              {pkg.unit}
            </div>
            
            <p class={`text-sm leading-relaxed mb-8 font-light ${pkg.featured ? 'text-white/70' : 'text-brand-charcoal/70'}`}>
              {pkg.description}
            </p>
            
            <ul class="space-y-3 mb-8">
              {pkg.features.map(feature => (
                <li class={`flex items-start gap-3 text-sm font-light pb-3 border-b ${pkg.featured ? 'border-white/10 text-white/85' : 'border-gray-100 text-brand-charcoal/85'}`}>
                  <span class={`w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5 ${pkg.featured ? 'bg-brand-gold/20 text-brand-gold' : 'bg-brand-gold/15 text-brand-goldDark'}`}>
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  </span> 
                  <span class="leading-relaxed">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
          
          <button 
            class={`mt-auto w-full py-4 rounded-full font-bold text-sm uppercase tracking-wider transition-all duration-300 ${pkg.featured ? 'bg-brand-gold text-brand-charcoal hover:bg-brand-goldLight hover:-translate-y-0.5 shadow-[0_4px_20px_rgba(235,183,52,0.4)]' : 'bg-transparent border-2 border-brand-charcoal/20 text-brand-charcoal hover:border-brand-gold hover:text-brand-gold hover:bg-brand-gold/5'}`}
            onclick={`window.open('${siteData.messengerUrl}', '_blank')`}>Message to Book</button>
        </div>
      ))}
    </div>

    <!-- FULL INTERACTIVE MENU SECTION -->
    <div class="mt-20 pt-16 border-t border-brand-gold/20" id="full-menu">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 bg-brand-gold/10 text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase px-4 py-1.5 rounded-full mb-3 border border-brand-gold/20">
          Full Salon Menu & Treatment Details
        </div>
        <h3 class="font-display lining-nums text-3xl md:text-4xl text-brand-charcoal font-semibold mb-3">
          Explore Our Complete <span class="italic text-brand-gold font-normal">Service Menu</span>
        </h3>
        <p class="text-brand-charcoal/65 text-sm md:text-base font-light max-w-xl mx-auto">
          Every service includes professional care, premium sanitation, and warm towel finish. Select a category below:
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex overflow-x-auto lg:flex-wrap justify-start lg:justify-center gap-2 md:gap-3 mb-12 pb-4 lg:pb-0 w-full [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] snap-x snap-mandatory" id="menu-tab-buttons">
        {menu.categories.map((cat, idx) => (
          <button 
            type="button"
            data-tab-target={`tab-${cat.id}`}
            class={`menu-tab-btn shrink-0 snap-start px-5 py-3 rounded-full text-sm font-semibold tracking-wide transition-all duration-300 flex items-center gap-2 border ${
              idx === 0 
                ? 'bg-brand-charcoal text-white border-brand-gold/50 shadow-md active-tab' 
                : 'bg-white text-brand-charcoal border-gray-200 hover:border-brand-gold hover:text-brand-gold'
            }`}
          >
            <span>{cat.name}</span>
            {cat.badge && (
              <span class={`text-[0.65rem] font-bold px-1.5 py-0.5 rounded-full ${idx === 0 ? 'bg-brand-gold text-brand-charcoal' : 'bg-brand-offwhite text-brand-charcoal'}`}>
                {cat.badge}
              </span>
            )}
          </button>
        ))}
      </div>

      <!-- TAB PANELS CONTAINER -->
      <div id="menu-tab-panels">
        
        <!-- 1. MANICURE PANEL -->
        <div id="tab-manicure" class="menu-panel block transition-opacity duration-300">
          <div class="mb-6 text-center max-w-2xl mx-auto">
            <h4 class="font-display lining-nums text-2xl font-bold text-brand-charcoal">Manicure Treatments</h4>
            <p class="text-brand-charcoal/60 text-sm font-light mt-2">{menu.categories[0].description}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
            {menu.categories[0].items.map(item => (
              <div class="h-full bg-white rounded-xl p-6 md:p-8 border border-gray-200 hover:border-brand-gold/40 hover:shadow-xl transition-all duration-300 flex flex-col">
                <div class="flex-grow">
                  <div class="flex justify-between items-start gap-4 mb-5 pb-5 border-b border-gray-100">
                    <h5 class="font-display lining-nums text-xl font-bold text-brand-charcoal leading-snug">{item.name}</h5>
                    <span class="font-display lining-nums text-3xl font-bold text-brand-goldDark whitespace-nowrap">{item.price}</span>
                  </div>
                  <div class="text-[0.65rem] font-bold uppercase tracking-[0.15em] text-brand-goldDark mb-4">Included Treatments</div>
                  <ul class="space-y-3 mb-6">
                    {item.steps.map(st => (
                      <li class="flex items-start gap-3 text-sm text-brand-charcoal/80 font-light">
                        <span class="w-5 h-5 rounded-full bg-brand-gold/15 text-brand-goldDark flex items-center justify-center shrink-0 mt-0.5">
                          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </span>
                        <span class="leading-relaxed">{st}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <a href={siteData.messengerUrl} target="_blank" rel="noopener noreferrer" class="mt-auto w-full text-center py-3 rounded-lg border border-gray-200 text-brand-charcoal font-semibold text-xs uppercase tracking-wider hover:border-brand-gold hover:text-brand-gold hover:bg-brand-gold/5 transition-colors">
                  Book This Service
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- 2. PEDICURE PANEL -->
        <div id="tab-pedicure" class="menu-panel hidden transition-opacity duration-300">
          <div class="mb-6 text-center max-w-2xl mx-auto">
            <h4 class="font-display lining-nums text-2xl font-bold text-brand-charcoal">Pedicure Spa Treatments</h4>
            <p class="text-brand-charcoal/60 text-sm font-light mt-2">{menu.categories[2].description}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
            {menu.categories[2].items.map(item => (
              <div class="h-full bg-white rounded-xl p-6 md:p-8 border border-gray-200 hover:border-brand-gold/40 hover:shadow-xl transition-all duration-300 flex flex-col">
                <div class="flex-grow">
                  <div class="flex justify-between items-start gap-4 mb-5 pb-5 border-b border-gray-100">
                    <div>
                      {item.badge && (
                        <span class="inline-block bg-brand-charcoal text-white text-[0.6rem] font-bold uppercase tracking-wider px-2 py-0.5 rounded-sm mb-2">
                          {item.badge}
                        </span>
                      )}
                      <h5 class="font-display lining-nums text-xl font-bold text-brand-charcoal leading-snug">{item.name}</h5>
                    </div>
                    <span class="font-display lining-nums text-3xl font-bold text-brand-goldDark whitespace-nowrap">{item.price}</span>
                  </div>
                  <div class="text-[0.65rem] font-bold uppercase tracking-[0.15em] text-brand-goldDark mb-4">Service Treatment Steps</div>
                  <ul class="space-y-3 mb-6">
                    {item.steps.map(st => (
                      <li class="flex items-start gap-3 text-sm text-brand-charcoal/80 font-light">
                        <span class="w-5 h-5 rounded-full bg-brand-gold/15 text-brand-goldDark flex items-center justify-center shrink-0 mt-0.5">
                          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </span>
                        <span class="leading-relaxed">{st}</span>
                      </li>
                    ))}
                  </ul>
                  {item.note && (
                    <div class="text-xs text-brand-charcoal/60 font-light italic bg-brand-offwhite rounded-lg px-4 py-2.5 mb-6 border border-gray-100">
                      📌 {item.note}
                    </div>
                  )}
                </div>
                <a href={siteData.messengerUrl} target="_blank" rel="noopener noreferrer" class="mt-auto w-full text-center py-3 rounded-lg border border-gray-200 text-brand-charcoal font-semibold text-xs uppercase tracking-wider hover:border-brand-gold hover:text-brand-gold hover:bg-brand-gold/5 transition-colors">
                  Book This Pedicure
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- 3. DIPPING POWDER PANEL -->
        <div id="tab-dipping" class="menu-panel hidden transition-opacity duration-300">
          <div class="mb-6 text-center max-w-2xl mx-auto">
            <h4 class="font-display lining-nums text-2xl font-bold text-brand-charcoal">Dipping Powder</h4>
            <p class="text-brand-charcoal/60 text-sm font-light mt-2">{menu.categories[1].description}</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-lg mx-auto items-stretch">
            {menu.categories[1].items.map(item => (
              <div class="h-full bg-white rounded-xl p-6 md:p-8 border border-gray-200 hover:border-brand-gold/40 hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
                <h5 class="font-display lining-nums text-xl font-bold text-brand-charcoal mb-4 leading-snug">{item.name}</h5>
                <div class="flex items-baseline justify-between pt-4 border-t border-gray-100">
                  <span class="text-[0.65rem] text-brand-charcoal/50 uppercase tracking-[0.1em]">Price</span>
                  <span class="font-display lining-nums text-3xl font-bold text-brand-goldDark">{item.price}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 4. ENHANCEMENT PANEL -->
        <div id="tab-enhancement" class="menu-panel hidden transition-opacity duration-300">
          <div class="mb-6 text-center max-w-2xl mx-auto">
            <h4 class="font-display lining-nums text-2xl font-bold text-brand-charcoal">Nail Enhancement</h4>
            <p class="text-brand-charcoal/60 text-sm font-light mt-2">{menu.categories[3].description}</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-stretch">
            {menu.categories[3].items.map(item => (
              <div class="h-full bg-white rounded-xl p-6 border border-gray-200 hover:border-brand-gold/40 hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
                <h5 class="font-body font-semibold text-sm text-brand-charcoal mb-4 leading-snug">{item.name}</h5>
                <div class="flex items-baseline justify-between pt-4 border-t border-gray-100">
                  <span class="text-[0.65rem] text-brand-charcoal/50 uppercase tracking-[0.1em]">Price</span>
                  <span class="font-display lining-nums text-2xl font-bold text-brand-goldDark">{item.price}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 5. ADD-ON PANEL -->
        <div id="tab-addons-polish" class="menu-panel hidden transition-opacity duration-300">
          <div class="mb-6 text-center max-w-2xl mx-auto">
            <h4 class="font-display lining-nums text-2xl font-bold text-brand-charcoal">Add-On Enhancements</h4>
            <p class="text-brand-charcoal/60 text-sm font-light mt-2">{menu.categories[4].description}</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-stretch">
            {menu.categories[4].addOns.map(ao => (
              <div class="h-full bg-white rounded-xl p-6 border border-gray-200 hover:border-brand-gold/40 hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
                <h5 class="font-body font-semibold text-sm text-brand-charcoal mb-4 leading-snug">{ao.name}</h5>
                <div class="flex items-baseline justify-between pt-4 border-t border-gray-100">
                  <span class="text-[0.65rem] text-brand-charcoal/50 uppercase tracking-[0.1em]">Price</span>
                  <span class="font-display lining-nums text-2xl font-bold text-brand-goldDark">{ao.price}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Kids Note -->
      {menu.kidsNote && (
        <div class="text-center mt-10 mb-4">
          <div class="inline-flex items-center gap-2 bg-brand-gold/10 border border-brand-gold/20 rounded-full px-6 py-2.5 text-sm font-medium text-brand-charcoal">
            <span class="text-brand-goldDark font-bold">*</span> {menu.kidsNote}
          </div>
        </div>
      )}

      <!-- Footer Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8 pt-10 border-t border-brand-gold/20">
        <a 
          href={siteData.messengerUrl} target="_blank" rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-10 py-4 rounded-full bg-brand-gold text-brand-charcoal hover:bg-brand-goldLight hover:-translate-y-0.5 shadow-lg shadow-brand-gold/30 font-bold text-sm uppercase tracking-wider transition-all duration-300"
        >
          Book Appointment
        </a>
      </div>

    </div>

  </div>

</section>

<!-- Client Script for Category Tabs -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabButtons = document.querySelectorAll('.menu-tab-btn');
    const panels = document.querySelectorAll('.menu-panel');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab-target');
        
        // Update button styles
        tabButtons.forEach(b => {
          b.classList.remove('bg-brand-charcoal', 'text-white', 'border-brand-gold/50', 'shadow-md', 'active-tab');
          b.classList.add('bg-white', 'text-brand-charcoal', 'border-gray-200');
          // Fix badge color if it exists
          const badge = b.querySelector('.rounded-full.text-\\[0\\.65rem\\]');
          if (badge) {
            badge.classList.remove('bg-brand-gold');
            badge.classList.add('bg-brand-offwhite');
          }
        });
        
        btn.classList.add('bg-brand-charcoal', 'text-white', 'border-brand-gold/50', 'shadow-md', 'active-tab');
        btn.classList.remove('bg-white', 'text-brand-charcoal', 'border-gray-200');
        
        const activeBadge = btn.querySelector('.rounded-full.text-\\[0\\.65rem\\]');
        if (activeBadge) {
          activeBadge.classList.add('bg-brand-gold');
          activeBadge.classList.remove('bg-brand-offwhite');
        }

        // Hide all panels, show target
        panels.forEach(p => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
            p.classList.add('block');
          } else {
            p.classList.add('hidden');
            p.classList.remove('block');
          }
        });
      });
    });
  });
</script>
