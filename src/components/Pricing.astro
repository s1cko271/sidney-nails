---
import siteData from '../data/site.json';
---

<div class="section-alt" id="pricing">
  <div style="max-width:1200px;margin:0 auto;padding:100px 4%">
    <div class="s-header center reveal">
      <div class="s-tag">{siteData.pricing.sectionTag}</div>
      <h2 class="s-title">{siteData.pricing.title} <span>{siteData.pricing.titleAccent}</span></h2>
      <p class="s-sub">{siteData.pricing.subtitle}</p>
      <div class="gilded-divider" aria-hidden="true">
        <span class="gilded-line"></span><span class="gilded-icon">✦</span><span class="gilded-line"></span>
      </div>

    </div>
    <div class="pricing-grid">
      {siteData.pricing.packages.map(pkg => (
        <div class={`pc reveal ${pkg.featured ? 'featured' : ''}`}>
          {pkg.featured && pkg.featuredLabel && (
            <div class="pc-pop">{pkg.featuredLabel}</div>
          )}
          <div class="pc-name">{pkg.name}</div>
          <div class="pc-price">{pkg.price}</div>
          <div class="pc-unit">{pkg.unit}</div>
          <p class="pc-desc">{pkg.description}</p>
          <ul class="pc-list">
            {pkg.features.map(feature => (
              <li><span class="pc-chk">✓</span> {feature}</li>
            ))}
          </ul>
          <button class="pc-btn" onclick="document.getElementById('booking')?.scrollIntoView({behavior:'smooth'}) || (window.location.href='/#booking')">Book Now</button>
        </div>
      ))}
    </div>
  </div>
</div>
