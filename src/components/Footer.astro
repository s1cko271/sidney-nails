---
import site from '../data/site.json';
---

<footer class="bg-charcoal text-white/80 pt-16 pb-8 border-t-[3px] border-gold">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand Info -->
      <div>
        <h3 class="font-display lining-nums text-2xl text-white mb-6">{site.salon?.name}</h3>
        <p class="font-light mb-4">{site.salon?.tagline}</p>
        <div class="flex flex-col gap-2 text-sm font-light">
          <p>{site.salon?.fullAddress}</p>
          {site.salon?.email && <p><a href={`mailto:${site.salon.email}`} class="hover:text-gold transition-colors">{site.salon.email}</a></p>}
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-sm uppercase tracking-widest text-white mb-6 font-semibold">Services</h4>
        <ul class="space-y-3 text-sm font-light">
          <li><a href="#services" class="hover:text-gold transition-colors">Manicures</a></li>
          <li><a href="#services" class="hover:text-gold transition-colors">Pedicures</a></li>
          <li><a href="#services" class="hover:text-gold transition-colors">Dipping Powder</a></li>
          <li><a href="#services" class="hover:text-gold transition-colors">Nail Enhancements</a></li>
          <li><a href="#pricing" class="hover:text-gold transition-colors">Polish & Add-ons</a></li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm uppercase tracking-widest text-white mb-6 font-semibold">Quick Links</h4>
        <ul class="space-y-3 text-sm font-light">
          <li><a href="#about" class="hover:text-gold transition-colors">About Us</a></li>
          <li><a href="#gallery" class="hover:text-gold transition-colors">Gallery</a></li>
          <li><a href="#pricing" class="hover:text-gold transition-colors">Pricing</a></li>
          <li><a href="#reviews" class="hover:text-gold transition-colors">Reviews</a></li>
          <li><a href={site.booking?.messengerUrl || "#book"} class="hover:text-gold transition-colors">Book Online</a></li>
        </ul>
      </div>

      <!-- Newsletter & Social -->
      <div>
        <h4 class="text-sm uppercase tracking-widest text-white mb-6 font-semibold">Stay Updated</h4>
        <p class="text-sm font-light mb-4">Subscribe to our newsletter for exclusive offers.</p>
        <form class="flex flex-col gap-3 mb-6" onsubmit="event.preventDefault();">
          <input type="email" placeholder="Email Address" class="bg-white/10 border border-white/20 rounded-lg px-4 py-2 text-white placeholder:text-white/50 focus:outline-none focus:border-gold" required />
          <button type="submit" class="bg-gold hover:bg-gold-light text-white px-4 py-2 rounded-lg uppercase tracking-widest text-sm font-medium transition-colors">Subscribe</button>
        </form>

        <div class="flex items-center gap-3">
          {site.social?.facebook && (
            <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/10 hover:bg-[#1877F2] flex items-center justify-center text-white transition-all hover:scale-105" aria-label="Facebook">
              <svg class="w-3.5 h-3.5" viewBox="0 0 320 512" fill="currentColor"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
            </a>
          )}
          {site.social?.instagram && (
            <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/10 hover:bg-[#E1306C] flex items-center justify-center text-white transition-all hover:scale-105" aria-label="Instagram">
              <svg class="w-3.5 h-3.5" viewBox="0 0 448 512" fill="currentColor"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
            </a>
          )}
          {site.social?.tiktok && (
            <a href={site.social.tiktok} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/10 hover:bg-black flex items-center justify-center text-white transition-all hover:scale-105" aria-label="TikTok">
              <svg class="w-3.5 h-3.5" viewBox="0 0 448 512" fill="currentColor"><path d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-light">
      <p>&copy; {new Date().getFullYear()} {site.salon?.name}. All rights reserved.</p>
      <p class="font-medium tracking-widest text-gold">{site.salon?.phone}</p>
    </div>
  </div>
</footer>
