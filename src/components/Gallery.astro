---
import siteData from '../data/site.json';

// Create a varied grid array. If we don't have enough, we'll slice. 
// The aesthetic calls for varied bento. Let's assume we have 5-7 images.
const bentoClasses = [
  "col-span-2 row-span-2 aspect-square md:aspect-auto", // Big feature
  "col-span-1 row-span-1 aspect-square",
  "col-span-1 row-span-1 aspect-square",
  "col-span-1 row-span-2 aspect-[1/2] md:aspect-auto", // Tall
  "col-span-2 md:col-span-1 row-span-1 aspect-[2/1] md:aspect-square", // Wide mobile, square desktop
  "col-span-1 row-span-1 aspect-square",
  "col-span-2 row-span-1 aspect-[2/1] md:aspect-[2/1]", // Wide bottom
];
---
<section id="gallery" class="py-24 bg-brand-offwhite">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 reveal">
      <div>
        <h2 class="font-display text-4xl md:text-5xl text-brand-charcoal mb-4">
          Our <em class="italic font-medium text-brand-gold">Work</em>
        </h2>
        <p class="text-brand-charcoal/60 text-sm max-w-sm">A glimpse into our serene space and the artistry of our technicians.</p>
      </div>
      <a href="https://instagram.com" class="hidden md:inline-block text-xs font-semibold uppercase tracking-widest text-brand-luxury border-b border-brand-luxury pb-1 hover:text-brand-gold hover:border-brand-gold transition-colors">Follow us on Instagram</a>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 auto-rows-[150px] md:auto-rows-[250px] reveal">
      {siteData.gallery.items.slice(0, 7).map((img, i) => (
        <div class={`relative group overflow-hidden rounded-2xl bg-brand-cream shadow-sm ${bentoClasses[i] || "col-span-1 row-span-1"}`}>
          <img src={img} alt="Sidney Nails Work" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-brand-charcoal/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        </div>
      ))}
    </div>
  </div>
</section>
