---
import siteData from '../data/site.json';
---
<section class="py-24 relative bg-brand-cream/70 backdrop-blur-md" id="gallery">
  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase mb-4">
        {siteData.gallery.sectionTag}
      </div>
      <h2 class="font-display lining-nums text-4xl md:text-5xl font-light text-brand-charcoal mb-4">
        {siteData.gallery.title} <span class="font-semibold italic text-brand-gold">{siteData.gallery.titleAccent}</span>
      </h2>
    </div>
    
    <div class="columns-2 md:columns-3 gap-2 md:gap-3 space-y-2 md:space-y-3">
      {siteData.gallery.items.map((item, index) => {
        const imgSrc = typeof item === 'string' ? item : item.image;
        const imgCaption = typeof item === 'string' ? 'Nail art design' : (item.caption || 'Nail art design');
        return (
          <div 
            class="group relative overflow-hidden rounded-md cursor-pointer reveal border border-brand-gold/80 hover:border-brand-goldDark transition-colors duration-300 break-inside-avoid transform-gpu shadow-sm"
            style={`--reveal-delay: ${(index % 3) * 100}ms;`}
          >
            <img 
              class="w-full h-auto block transition-transform duration-700 group-hover:scale-105" 
              src={imgSrc} 
              alt={imgCaption} 
              loading="lazy" 
            />
          </div>
        );
      })}
    </div>

    <!-- Social follow link -->
    <div class="text-center mt-12 reveal">
      <a 
        href={siteData.social?.instagram && !siteData.social.instagram.startsWith('TODO') ? siteData.social.instagram : 'https://www.instagram.com'} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-navy border-b border-brand-gold/60 pb-1 hover:text-brand-gold hover:border-brand-gold transition-colors"
      >
        Follow On Instagram &rarr;
      </a>
    </div>
  </div>
</section>
