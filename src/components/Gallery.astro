---
import siteData from '../data/site.json';
---
<section class="py-24 bg-brand-cream" id="gallery">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase mb-4">
        {siteData.gallery.sectionTag}
      </div>
      <h2 class="font-display text-4xl md:text-5xl font-light text-brand-charcoal mb-4">
        {siteData.gallery.title} <span class="font-semibold italic text-brand-gold">{siteData.gallery.titleAccent}</span>
      </h2>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 auto-rows-[250px] md:auto-rows-[280px]">
      {siteData.gallery.items.map((item, index) => (
        <div class={`group relative overflow-hidden rounded-xl cursor-pointer reveal ${index === 0 ? 'sm:col-span-2 sm:row-span-2' : ''}`}>
          <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 group-hover:rotate-1" src={item.image} alt={item.caption} />
          
          <!-- Gradient ONLY at the bottom to preserve WCAG AA contrast for the text -->
          <div class="absolute bottom-0 left-0 right-0 pt-20 pb-5 px-5 bg-gradient-to-t from-brand-charcoal/95 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
            <span class="text-white text-sm font-medium tracking-wide drop-shadow-md">{item.caption}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

{siteData.promo.enabled && (
  <div class="bg-brand-charcoal relative py-24 px-6 text-center overflow-hidden border-t border-brand-gold/20 shadow-2xl">
    <!-- Luxury Background Accents -->
    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-goldDark via-brand-goldLight to-brand-goldDark"></div>
    <div class="absolute inset-0 opacity-[0.03] bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-transparent to-transparent"></div>
    
    <div class="max-w-2xl mx-auto relative z-10">
      <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-4">Special Offer</div>
      <h2 class="font-display text-4xl md:text-5xl text-white font-light mb-6">{siteData.promo.headline}</h2>
      <p class="text-brand-cream/80 font-light tracking-wide mb-10 text-lg leading-relaxed">{siteData.promo.text}</p>
      <a class="inline-block bg-brand-gold text-brand-charcoal px-10 py-4 rounded-full font-bold text-sm uppercase tracking-widest hover:bg-white hover:text-brand-charcoal hover:shadow-[0_0_25px_rgba(212,175,55,0.4)] transition-all duration-300 motion-safe:hover:-translate-y-1" href="/#booking">
        {siteData.promo.buttonText}
      </a>
    </div>
  </div>
)}

