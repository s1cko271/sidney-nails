---
import siteData from '../data/site.json';
---
<section class="py-24 relative bg-brand-cream/70" id="gallery">
  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase mb-4">
        {siteData.gallery.sectionTag}
      </div>
      <h2 class="font-display lining-nums text-4xl md:text-5xl font-light text-brand-charcoal mb-4">
        {siteData.gallery.title} <span class="font-semibold italic text-brand-gold">{siteData.gallery.titleAccent}</span>
      </h2>
    </div>
    
    <div class="columns-2 md:columns-3 gap-2 md:gap-3 space-y-2 md:space-y-3">
      {siteData.gallery.items.map((item, index) => (
        <div class="group relative overflow-hidden rounded-md cursor-pointer reveal border border-brand-gold/80 hover:border-brand-goldDark transition-colors duration-300 break-inside-avoid transform-gpu shadow-sm">
          <img class="w-full h-auto block transition-transform duration-700 group-hover:scale-105" src={item.image} alt={item.caption || "Nail art design"} loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

{siteData.promo.enabled && (
  <div class="bg-brand-charcoal relative py-12 md:py-24 px-6 text-center overflow-hidden border-t border-brand-gold/20 shadow-2xl">
    <!-- Luxury Background Accents -->
    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-goldDark via-brand-goldLight to-brand-goldDark"></div>
    <div class="absolute inset-0 opacity-[0.03] bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-brand-gold/10 via-transparent to-transparent"></div>
    
    <div class="max-w-4xl mx-auto relative z-10">
      {siteData.promo.image ? (
        <a href="/#booking" class="block group relative rounded-2xl overflow-hidden shadow-[0_15px_40px_rgba(0,0,0,0.6)] border border-brand-gold/30 hover:border-brand-gold/60 transition-colors duration-300">
          <img src={siteData.promo.image} alt="Special Offer" class="w-full h-auto object-contain transform-gpu transition-transform duration-700 group-hover:scale-[1.02]" />
          <div class="absolute inset-0 bg-brand-charcoal/0 group-hover:bg-brand-charcoal/10 transition-colors duration-300 pointer-events-none"></div>
        </a>
      ) : (
        <>
          <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-4">Special Offer</div>
          <h2 class="font-display lining-nums text-4xl md:text-5xl text-white font-light mb-6">{siteData.promo.headline}</h2>
          <p class="text-brand-cream/80 font-light tracking-wide mb-10 text-lg leading-relaxed">{siteData.promo.text}</p>
          <a class="inline-block bg-brand-gold text-brand-charcoal px-10 py-4 rounded-full font-bold text-sm uppercase tracking-widest hover:bg-white hover:text-brand-charcoal hover:shadow-[0_0_25px_rgba(159,184,212,0.4)] transition-all duration-300 motion-safe:hover:-translate-y-1" href="/#booking">
            {siteData.promo.buttonText}
          </a>
        </>
      )}
    </div>
  </div>
)}

