---
import siteData from '../data/site.json';
---
<div id="promo-popup" class="fixed inset-0 z-[100] flex items-center justify-center hidden opacity-0 transition-opacity duration-500 pointer-events-none" role="dialog" aria-modal="true" aria-label="Special Offer">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-brand-charcoal/40 backdrop-blur-sm" id="popup-backdrop" aria-hidden="true"></div>
  
  <!-- Modal Content -->
  <div class="relative w-[90%] max-w-[500px] bg-white rounded-2xl shadow-floating overflow-hidden flex flex-col transform scale-95 transition-transform duration-500 pointer-events-auto" id="popup-content">
    
    <!-- Close Button (44px min touch target) -->
    <button id="popup-close" class="absolute top-3 right-3 w-11 h-11 flex items-center justify-center bg-white/80 backdrop-blur-md rounded-full text-brand-charcoal hover:bg-brand-gold hover:text-white transition-colors z-10 focus:outline-none focus:ring-2 focus:ring-brand-gold shadow-sm" aria-label="Close dialog">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    
    <!-- Popup Image as a link to messenger -->
    <a href={siteData.booking.messengerUrl} class="block focus:outline-none focus:ring-4 focus:ring-inset focus:ring-brand-gold">
      <img src="/images/popup.webp" alt="Special Offer at Sidney Nails" class="w-full h-auto object-cover" loading="lazy" />
    </a>
  </div>
</div>

<script is:inline>
(function() {
  const popup = document.getElementById('promo-popup');
  const content = document.getElementById('popup-content');
  const closeBtn = document.getElementById('popup-close');
  const backdrop = document.getElementById('popup-backdrop');
  
  if (!popup || !content || !closeBtn || !backdrop) return;
  
  const STORAGE_KEY = 'sidney_nails_popup_seen';
  let hasSeen = false;
  try { hasSeen = sessionStorage.getItem(STORAGE_KEY) === 'true'; } catch(e) {}
  
  if (hasSeen) return;
  
  const focusableElements = popup.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
  const firstFocusable = focusableElements[0];
  const lastFocusable = focusableElements[focusableElements.length - 1];
  let previousActiveElement = null;
  
  function openPopup() {
    popup.classList.remove('hidden');
    void popup.offsetWidth;
    popup.classList.remove('opacity-0', 'pointer-events-none');
    popup.classList.add('opacity-100');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      content.classList.remove('scale-95');
      content.classList.add('scale-100');
    } else {
      content.classList.remove('scale-95');
      content.style.transition = 'none';
      popup.style.transition = 'none';
    }
    previousActiveElement = document.activeElement;
    setTimeout(() => { if(closeBtn) closeBtn.focus(); }, 100);
    try { sessionStorage.setItem(STORAGE_KEY, 'true'); } catch(e) {}
  }
  
  function closePopup() {
    popup.classList.remove('opacity-100');
    popup.classList.add('opacity-0', 'pointer-events-none');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
    }
    setTimeout(() => {
      popup.classList.add('hidden');
      if (previousActiveElement) previousActiveElement.focus();
    }, 500);
  }
  
  setTimeout(openPopup, 4000);
  
  closeBtn.addEventListener('click', closePopup);
  backdrop.addEventListener('click', closePopup);
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !popup.classList.contains('hidden')) closePopup();
    if (e.key === 'Tab' && !popup.classList.contains('hidden')) {
      if (e.shiftKey) {
        if (document.activeElement === firstFocusable) { e.preventDefault(); lastFocusable.focus(); }
      } else {
        if (document.activeElement === lastFocusable) { e.preventDefault(); firstFocusable.focus(); }
      }
    }
  });
})();
</script>
