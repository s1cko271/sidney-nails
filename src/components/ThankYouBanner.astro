---
import siteData from '../data/site.json';
---
<section class="relative py-24 bg-brand-charcoal overflow-hidden">
  <div class="absolute inset-0">
    <img src="/images/popup.webp" alt="Thank You" class="w-full h-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-brand-luxury/80 mix-blend-multiply"></div>
  </div>
  <div class="relative z-10 max-w-[800px] mx-auto px-6 text-center reveal">
    <h2 class="font-display text-4xl md:text-6xl text-brand-cream mb-6">
      Thank <em class="italic font-medium text-brand-gold">You</em>
    </h2>
    <p class="text-brand-cream/80 text-lg max-w-2xl mx-auto font-body font-light">
      We appreciate your support and look forward to welcoming you to Sidney Nails.
    </p>
  </div>
</section>
