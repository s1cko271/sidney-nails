---
import siteData from '../data/site.json';

// Helper function to map site.json emoji icons to SVG strings
function getSvgIcon(icon) {
  if (icon === '✨') return '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-brand-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>';
  if (icon === '🎁') return '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-brand-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 1 0 9.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1 1 14.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" /></svg>';
  if (icon === '👯‍♀️') return '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-brand-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>';
  
  if (icon === 'shield') return '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-brand-gold"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>';
    
    // Fallback if something else is used
  return icon;
}
---
<section class="py-24 bg-white" id="promotions">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase mb-4">
        {siteData.promotions.sectionTag}
      </div>
      <h2 class="font-display text-4xl md:text-5xl font-light text-brand-charcoal mb-4">
        {siteData.promotions.title} <span class="font-semibold italic text-brand-gold">{siteData.promotions.titleAccent}</span>
      </h2>
      <p class="text-brand-charcoal/60 leading-relaxed font-light">
        {siteData.promotions.subtitle}
      </p>
      <div class="flex items-center justify-center gap-3 mt-8 opacity-70" aria-hidden="true">
        <span class="w-12 h-px bg-brand-gold"></span>
        <span class="text-brand-gold text-xs">✦</span>
        <span class="w-12 h-px bg-brand-gold"></span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {siteData.promotions.items.map(promo => (
        <div class="bg-white rounded-2xl border border-brand-charcoal/5 p-10 text-center flex flex-col items-center shadow-soft hover:shadow-2xl motion-safe:hover:-translate-y-1.5 hover:border-brand-gold/30 transition-all duration-500 reveal">
           <div class="w-16 h-16 bg-brand-charcoal/5 rounded-full flex items-center justify-center text-3xl mb-6 shadow-inner border border-brand-charcoal/5" set:html={getSvgIcon(promo.icon)}>
           </div>
           <h3 class="font-display text-2xl font-semibold text-brand-charcoal mb-4">{promo.title}</h3>
           <p class="text-brand-charcoal/60 text-sm leading-relaxed font-light mb-8 flex-grow">{promo.description}</p>
           <div class="text-brand-goldDark font-bold text-lg bg-brand-cream px-6 py-2.5 rounded-full border border-brand-gold/20 tracking-wide">
             {promo.offer}
           </div>
        </div>
      ))}
    </div>
  </div>
</section>

