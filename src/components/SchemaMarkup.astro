---
import site from '../data/site.json';

const schema = {
  "@context": "https://schema.org",
  "@type": "NailSalon",
  "name": site.salon.name,
  "image": new URL('/images/salon-1.webp', site.url || 'https://sidneynails.com').toString(),
  "@id": site.url || 'https://sidneynails.com',
  "url": site.url || 'https://sidneynails.com',
  "telephone": site.salon.phoneRaw || "+14064335555",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "422 N Central Ave",
    "addressLocality": "Sidney",
    "addressRegion": "MT",
    "postalCode": "59270",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 47.7171,
    "longitude": -104.1568
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "10:00",
      "closes": "19:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday"],
      "opens": "11:00",
      "closes": "17:00"
    }
  ],
  "sameAs": [
    site.social.googleMaps || "https://maps.app.goo.gl/th34qAzZDDTthUoLA"
  ],
  "priceRange": "$$"
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
