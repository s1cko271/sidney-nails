---
import site from '../data/site.json';
---

<section id="contact" class="bg-charcoal text-white py-20 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-display text-white mb-4">Visit Us Today</h2>
      <div class="w-24 h-px bg-gold mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
      <!-- Address & Parking -->
      <div>
        <h3 class="text-2xl font-display text-gold mb-6 uppercase tracking-widest text-sm">Location</h3>
        <p class="text-gray-300 text-lg mb-2">{site.contact.address.street}</p>
        <p class="text-gray-300 text-lg mb-6">{site.contact.address.city}, {site.contact.address.state} {site.contact.address.zip}</p>
        
        <h3 class="text-lg font-display text-gold mb-2 mt-8">Parking</h3>
        <p class="text-gray-400">{site.contact.parking}</p>
      </div>

      <!-- Hours -->
      <div>
        <h3 class="text-2xl font-display text-gold mb-6 uppercase tracking-widest text-sm">Hours</h3>
        <ul class="space-y-3 text-gray-300">
          {Object.entries(site.hours).map(([day, time]) => (
            <li class="flex justify-between border-b border-gray-800 pb-2">
              <span class="capitalize">{day}</span>
              <span>{time}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-2xl font-display text-gold mb-6 uppercase tracking-widest text-sm">Connect</h3>
        <div class="space-y-4 mb-8">
          <p>
            <a href={`tel:${site.contact.phone}`} class="text-xl hover:text-gold transition-colors flex items-center">
              <svg class="w-5 h-5 mr-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              {site.contact.phone}
            </a>
          </p>
          <p>
            <a href={`mailto:${site.contact.email}`} class="text-lg text-gray-300 hover:text-gold transition-colors flex items-center">
              <svg class="w-5 h-5 mr-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              {site.contact.email}
            </a>
          </p>
        </div>

        <div class="flex space-x-4">
          {site.social.facebook && (
            <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-gold transition-colors">
              <span class="sr-only">Facebook</span>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          )}
          {site.social.instagram && (
            <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-gold transition-colors">
              <span class="sr-only">Instagram</span>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          )}
          {site.social.tiktok && (
            <a href={site.social.tiktok} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-gold transition-colors">
              <span class="sr-only">TikTok</span>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.22-1.15 4.39-2.91 5.75-1.77 1.37-4.14 1.83-6.28 1.34-2.13-.48-3.95-1.92-4.88-3.87-.93-1.95-.91-4.26.04-6.19.95-1.93 2.74-3.37 4.81-3.91 2.07-.54 4.31-.22 6.18.89.02-1.39-.02-2.77.01-4.16-1.45-.63-3.11-.8-4.66-.48-1.55.32-2.93 1.25-3.88 2.53-.96 1.29-1.33 2.95-1.07 4.51.26 1.56 1.19 2.96 2.5 3.84 1.31.88 2.99 1.22 4.54.91 1.54-.31 2.88-1.28 3.7-2.58.82-1.31 1.12-2.93.85-4.48-.26-1.55-1.14-2.95-2.42-3.87-1.28-.93-2.92-1.3-4.48-1.01v-4.08c1.39-.01 2.78.01 4.16-.01z"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Map Full Width -->
    <div class="h-96 rounded-2xl overflow-hidden">
      <iframe 
        src={site.contact.googleMapsEmbed} 
        width="100%" 
        height="100%" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title="Google Maps Location">
      </iframe>
    </div>
  </div>
</section>
