---
import site from '../data/site.json';
---

<header id="navbar" class="fixed left-0 right-0 top-3 md:top-4 z-50 transition-all duration-300 pointer-events-none px-3 sm:px-6 md:px-8">
  <div class="max-w-[1140px] mx-auto pointer-events-auto">
    <div class="flex justify-between items-center bg-[#475569]/65 md:bg-slate-800/55 backdrop-blur-xl border border-white/25 rounded-full px-4 sm:px-6 md:px-7 py-2 md:py-2.5 shadow-[0_8px_32px_rgba(0,0,0,0.28)] transition-all duration-300">
      
      <!-- Logo & Name -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-2.5 sm:gap-3 group">
          <div class="w-8 h-8 sm:w-9 sm:h-9 md:w-10 md:h-10 rounded-full bg-white p-0.5 sm:p-1 flex items-center justify-center border border-sky-300/60 shadow-sm flex-shrink-0 overflow-hidden group-hover:scale-105 transition-transform">
            <img src={site.salon?.logoSquare || '/images/logo.png'} alt={site.salon?.name} class="w-full h-full object-contain rounded-full" />
          </div>
          <span class="font-display font-bold text-base sm:text-lg md:text-xl text-white tracking-wide">
            {site.salon?.namePart1 || 'Sidney'} <span class="text-[#9EC5EA] font-normal not-italic">{site.salon?.namePart2 || 'Nails'}</span>
          </span>
        </a>
      </div>
      
      <!-- Desktop Menu: Ordered chronologically to match page flow (Videos -> Gallery -> Services -> Pricing -> About -> Reviews -> Contact) -->
      <nav class="hidden lg:flex items-center gap-5 xl:gap-7">
        <a href="/#videos" class="text-[11px] xl:text-xs font-bold uppercase tracking-[0.16em] text-white/85 hover:text-white transition-colors">Videos</a>
        <a href="/#gallery" class="text-[11px] xl:text-xs font-bold uppercase tracking-[0.16em] text-white/85 hover:text-white transition-colors">Gallery</a>
        <a href="/#services" class="text-[11px] xl:text-xs font-bold uppercase tracking-[0.16em] text-white/85 hover:text-white transition-colors">Services</a>
        <a href="/#pricing" class="text-[11px] xl:text-xs font-bold uppercase tracking-[0.16em] text-white/85 hover:text-white transition-colors">Pricing</a>
        <a href="/#about" class="text-[11px] xl:text-xs font-bold uppercase tracking-[0.16em] text-white/85 hover:text-white transition-colors">About</a>
        <a href="/#reviews" class="text-[11px] xl:text-xs font-bold uppercase tracking-[0.16em] text-white/85 hover:text-white transition-colors">Reviews</a>
        <a href="/#booking" class="text-[11px] xl:text-xs font-bold uppercase tracking-[0.16em] text-white/85 hover:text-white transition-colors">Contact</a>
      </nav>

      <!-- CTA Button Desktop -->
      <div class="hidden md:flex items-center">
        <a href="/#booking" class="bg-[#9CBFE4] hover:bg-white text-[#13253B] px-5 sm:px-6 py-2 md:py-2.5 rounded-full font-bold text-xs uppercase tracking-wider transition-all duration-300 shadow-sm hover:shadow hover:-translate-y-0.5">
          {site.nav?.ctaText || 'Book Now'}
        </a>
      </div>

      <!-- Mobile Nav Actions -->
      <div class="flex items-center gap-2 lg:hidden">
        <a class="md:hidden bg-[#9CBFE4] hover:bg-white text-[#13253B] px-3.5 py-1.5 rounded-full font-bold text-[11px] uppercase tracking-wider transition-colors shadow-sm" href="/#booking">
          Book
        </a>
        <button id="mobile-menu-btn" type="button" class="inline-flex items-center justify-center p-2 rounded-lg text-white hover:text-[#9CBFE4] focus:outline-none" aria-expanded="false" aria-label="Open Navigation Menu">
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="hidden fixed inset-0 z-40 bg-brand-charcoal/95 backdrop-blur flex-col justify-center items-center h-screen w-full pointer-events-auto">
    <button id="mobile-close-btn" class="absolute top-6 right-6 p-2 text-white hover:text-brand-gold">
      <svg class="h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <nav class="flex flex-col space-y-7 text-center">
      <a href="#videos" class="mobile-link text-white text-xl font-medium uppercase tracking-widest hover:text-brand-gold transition-colors">Videos</a>
      <a href="#gallery" class="mobile-link text-white text-xl font-medium uppercase tracking-widest hover:text-brand-gold transition-colors">Gallery</a>
      <a href="#services" class="mobile-link text-white text-xl font-medium uppercase tracking-widest hover:text-brand-gold transition-colors">Services</a>
      <a href="#pricing" class="mobile-link text-white text-xl font-medium uppercase tracking-widest hover:text-brand-gold transition-colors">Pricing</a>
      <a href="#about" class="mobile-link text-white text-xl font-medium uppercase tracking-widest hover:text-brand-gold transition-colors">About</a>
      <a href="#reviews" class="mobile-link text-white text-xl font-medium uppercase tracking-widest hover:text-brand-gold transition-colors">Reviews</a>
      
      <a href="/#booking" class="mobile-link mt-8 bg-brand-gold text-brand-charcoal px-8 py-3 rounded-full text-lg font-bold uppercase tracking-widest hover:bg-brand-goldLight transition-colors">
        Book Appointment
      </a>
      <p class="mt-8 text-brand-gold/50 font-medium tracking-widest text-sm">{site.salon?.bookingPhoneFormatted || '(406) 433-5555'}</p>
    </nav>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  // Mobile menu toggle
  const toggleMenu = () => {
    mobileMenu?.classList.toggle('hidden');
    mobileMenu?.classList.toggle('flex');
    document.body.classList.toggle('overflow-hidden');
  };

  mobileBtn?.addEventListener('click', toggleMenu);
  closeBtn?.addEventListener('click', toggleMenu);
  mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));
</script>
