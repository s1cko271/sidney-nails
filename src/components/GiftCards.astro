---
import site from '../data/site.json';
---

<section id="gift-cards" class="py-20 bg-ivory">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-display lining-nums text-charcoal mb-4">Gift Cards & Special Offers</h2>
      <div class="w-24 h-px bg-gold mx-auto mb-6"></div>
      <p class="text-gray-600 max-w-2xl mx-auto font-body text-lg">Treat yourself or a loved one with our exclusive salon offers and gift cards.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {Object.entries(site.promotions).filter(([key]) => key !== 'giftCards').map(([key, promo]) => (
        <div class="bg-white rounded-2xl p-8 border border-brand-gold/25 shadow-[0_0_35px_rgba(159,184,212,0.25),0_15px_45px_rgba(0,0,0,0.2),0_5px_18px_rgba(0,0,0,0.12)] hover:shadow-[0_0_55px_rgba(159,184,212,0.45),0_20px_55px_rgba(0,0,0,0.28),0_8px_22px_rgba(0,0,0,0.18)] hover:border-brand-gold/45 hover:-translate-y-1 transition-transform duration-300 flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-ivory flex items-center justify-center mb-6 border border-gold-light">
            <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
          </div>
          <h3 class="text-2xl font-display lining-nums text-charcoal mb-3">{promo.title}</h3>
          <p class="text-gray-600 flex-grow">{promo.description}</p>
        </div>
      ))}
    </div>

    <div class="max-w-4xl mx-auto bg-white rounded-3xl overflow-hidden shadow-[0_0_45px_rgba(159,184,212,0.3),0_18px_50px_rgba(0,0,0,0.25),0_6px_20px_rgba(0,0,0,0.15)] flex flex-col md:flex-row border border-brand-gold/30">
      <div class="md:w-1/2 bg-charcoal p-10 flex flex-col justify-center text-white text-center md:text-left relative">
        <!-- Abstract Gold Accent -->
        <div class="absolute top-0 right-0 w-32 h-32 bg-gold opacity-10 rounded-bl-full pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-24 h-24 bg-gold-light opacity-10 rounded-tr-full pointer-events-none"></div>
        
        <h3 class="text-3xl font-display lining-nums mb-4 relative z-10">{site.promotions.giftCards.title}</h3>
        <p class="text-gray-300 mb-8 relative z-10">{site.promotions.giftCards.description}</p>
        <div class="relative z-10">
            <a href={site.promotions.giftCards.purchaseUrl} target="_blank" rel="noopener noreferrer" class="inline-block bg-gold text-white font-semibold py-3 px-8 rounded-full hover:bg-gold-light transition-colors">
            Purchase e-Gift Card
            </a>
        </div>
      </div>
      <div class="md:w-1/2 p-8 md:p-12 flex items-center justify-center bg-ivory">
        <div class="w-full max-w-sm aspect-[1.586/1] bg-gradient-to-br from-charcoal to-black rounded-xl p-6 relative shadow-xl overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-gold rounded-full -mr-20 -mt-20 opacity-20"></div>
            <div class="absolute bottom-0 left-0 w-32 h-32 bg-gold-light rounded-full -ml-16 -mb-16 opacity-20"></div>
            <div class="relative h-full flex flex-col justify-between">
                <div>
                    <h4 class="font-display lining-nums text-2xl text-white tracking-wider">{site.name}</h4>
                    <p class="text-gold text-xs uppercase tracking-widest mt-1">Gift Card</p>
                </div>
                <div class="flex justify-end">
                    <div class="w-12 h-8 border border-gold/50 rounded flex items-center justify-center opacity-80">
                        <div class="w-8 h-4 bg-gold/20"></div>
                    </div>
                </div>
            </div>
        </div>
      </div>
    </div>
  </div>
</section>
