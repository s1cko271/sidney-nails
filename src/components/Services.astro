---
import siteData from '../data/site.json';
---
<section class="py-24 md:py-32 relative bg-white/75" id="services">
  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-brand-goldDark text-xs font-bold tracking-[0.2em] uppercase mb-4">
        {siteData.services.sectionTag}
      </div>
      <h2 class="font-display lining-nums text-4xl md:text-5xl font-light text-brand-charcoal mb-4">
        {siteData.services.title} <span class="font-semibold italic text-brand-gold">{siteData.services.titleAccent}</span>
      </h2>
      <p class="text-brand-charcoal/60 leading-relaxed font-light text-justify [text-align-last:center]">
        {siteData.services.subtitle}
      </p>
      <div class="flex items-center justify-center gap-3 mt-8 opacity-70" aria-hidden="true">
        <span class="w-12 h-px bg-brand-gold"></span>
        <span class="text-brand-gold animate-spin-slow flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z"/></svg>
        </span>
        <span class="w-12 h-px bg-brand-gold"></span>
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-6 lg:gap-8">
      {siteData.services.items.map((svc, index) => (
        <a href={siteData.messengerUrl} target="_blank" rel="noopener noreferrer" class="w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] max-w-md lg:max-w-none group bg-gradient-to-br from-white to-gray-50 rounded-2xl overflow-hidden border border-transparent shadow-[0_0_40px_rgba(235,183,52,0.3),0_15px_50px_rgba(0,0,0,0.25),0_5px_20px_rgba(0,0,0,0.15)] border-brand-gold/30 hover:shadow-[0_0_60px_rgba(235,183,52,0.5),0_20px_60px_rgba(0,0,0,0.3),0_8px_25px_rgba(0,0,0,0.2)] hover:border-brand-gold/60 hover:scale-[1.03] hover:-translate-y-2 transition-all duration-500 cursor-pointer flex flex-col reveal">
          <div class="relative aspect-[4/5] overflow-hidden bg-brand-cream/20">
            <img class="w-full h-full object-cover object-center transition-transform duration-700 motion-safe:group-hover:scale-110" src={svc.image} alt={svc.name} />
            <div class="absolute top-4 left-4 w-10 h-10 rounded-full bg-white/95 flex items-center justify-center text-brand-charcoal text-xs font-bold font-body shadow-sm">
              {String(index + 1).padStart(2, '0')}
            </div>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="font-display lining-nums text-2xl font-semibold text-brand-charcoal mb-3">{svc.name}</h3>
            <p class="text-brand-charcoal/60 text-sm leading-relaxed mb-8 font-light flex-grow">{svc.description}</p>
            
            <div class="flex justify-between items-center pt-6 border-t border-brand-creamDark">
              <span class="font-semibold text-brand-goldDark text-lg tracking-wide">{svc.price}</span>
              <span class="w-10 h-10 rounded-full border border-brand-charcoal/20 flex items-center justify-center text-brand-charcoal/40 group-hover:bg-brand-gold group-hover:border-brand-gold group-hover:text-white transition-all duration-300">
                <span class="motion-safe:group-hover:translate-x-1 transition-transform duration-300 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </span>
              </span>
            </div>
          </div>
        </a>
      ))}

