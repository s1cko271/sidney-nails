---
import siteData from '../data/site.json';

const services = siteData.services.items;

// Portrait / square items will have centered photo + ambient blurred backdrop fill (matching Image 2)
// Landscape items (Pedicure, Waxing) fill edge-to-edge
const isWideImage = (idx: number) => idx === 1 || idx === 4;
---

<section class="py-24 md:py-32 bg-[#0B1422] text-white relative overflow-hidden border-t border-[#2D5A8B]/40" id="services">
  <!-- Subtle ambient glow background -->
  <div class="absolute top-1/4 -left-32 w-96 h-96 bg-[#1B3A5C]/25 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-sky-900/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-[1080px] mx-auto px-6 sm:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-20 md:mb-24 reveal">
      <div class="inline-flex items-center justify-center px-4 py-1.5 rounded-full border border-sky-400/30 bg-sky-950/50 text-[#9EC5EA] text-[10px] sm:text-[11px] font-bold tracking-[0.25em] uppercase mb-4 shadow-[0_0_15px_rgba(56,189,248,0.1)]">
        OUR SERVICES
      </div>

      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-normal text-white mb-4 leading-[1.18] tracking-tight">
        Complete Nail Care <em class="italic font-normal text-[#9EC5EA]">&amp; Beauty</em><br />
        <em class="italic font-normal text-[#9EC5EA]">Services</em>
      </h2>

      <p class="text-white/70 max-w-xl mx-auto text-xs sm:text-sm font-light leading-relaxed mb-6">
        From classic manicures to creative nail art &mdash; we offer a full range of services using premium products for lasting results.
      </p>

      <!-- Ornamental Divider (── ◇ ──) -->
      <div class="flex items-center justify-center gap-3 opacity-60" aria-hidden="true">
        <span class="w-12 h-px bg-gradient-to-r from-transparent to-sky-300/50"></span>
        <span class="w-1.5 h-1.5 rotate-45 border border-sky-300/80 bg-sky-400/30"></span>
        <span class="w-12 h-px bg-gradient-to-l from-transparent to-sky-300/50"></span>
      </div>
    </div>

    <!-- Alternating Z-Pattern Services Grid - Unified Frame Shape for all cards -->
    <div class="space-y-20 md:space-y-28">
      {services.map((svc, index) => {
        const isEven = index % 2 === 0;
        const numberBadge = String(index + 1).padStart(2, '0');
        const isLandscape = isWideImage(index);

        return (
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
            
            {/* Image Column (6 cols) */}
            <div class={`lg:col-span-6 flex ${isEven ? 'lg:order-1 lg:justify-end reveal-left' : 'lg:order-2 lg:justify-start reveal-right'} justify-center`}>
              <div class="relative group w-full max-w-[480px]">
                
                <!-- Ambient Golden-Cyan Backlight Glow -->
                <div class="absolute -inset-1 rounded-[2.1rem] bg-gradient-to-tr from-amber-400/25 via-sky-400/35 to-amber-300/25 blur-lg opacity-60 group-hover:opacity-90 transition-opacity duration-500 pointer-events-none"></div>

                <!-- Sparkling Golden-Cyan Border Frame (Synchronized Shape across all 5 cards) -->
                <div class="relative p-[2.5px] sm:p-[3px] rounded-[1.85rem] sm:rounded-[2.1rem] service-shimmer-border shadow-[0_0_25px_rgba(245,158,11,0.25),0_0_35px_rgba(56,189,248,0.25)] ring-1 ring-sky-300/40 transition-all duration-500 group-hover:shadow-[0_0_35px_rgba(245,158,11,0.4),0_0_45px_rgba(56,189,248,0.4)]">
                  
                  <!-- Unified Shape Aspect Ratio Container (16 / 10) -->
                  <div class="relative overflow-hidden rounded-[calc(1.85rem-2.5px)] sm:rounded-[calc(2.1rem-3px)] aspect-[16/10] bg-slate-900 flex items-center justify-center">
                    
                    <!-- Ambient blurred backdrop fill (ensures 0 empty gaps for portrait/square photos) -->
                    <img 
                      src={svc.image} 
                      alt="" 
                      aria-hidden="true"
                      class="absolute inset-0 w-full h-full object-cover blur-md scale-110 opacity-70 brightness-90 pointer-events-none" 
                      loading="lazy" 
                    />
                    
                    <!-- Sharp Foreground Image -->
                    {isLandscape ? (
                      /* Full-bleed landscape cover for wide photos (Pedicure, Waxing) */
                      <img 
                        src={svc.image} 
                        alt={svc.name} 
                        class="relative z-10 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105" 
                        loading="lazy" 
                      />
                    ) : (
                      /* Centered full-view portrait/square photo with soft shadow (Manicure, Dipping, Enhancement) */
                      <img 
                        src={svc.image} 
                        alt={svc.name} 
                        class="relative z-10 w-auto h-full max-w-full mx-auto object-contain object-center transition-transform duration-700 ease-out group-hover:scale-105 drop-shadow-md" 
                        loading="lazy" 
                      />
                    )}
                    
                    <!-- Subtle vignette gradient -->
                    <div class="absolute inset-0 z-10 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>

                    <!-- Circular Number Badge (01, 02, etc.) -->
                    <div class="absolute top-4 left-4 sm:top-5 sm:left-5 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white text-[#0B1422] font-body font-bold text-xs flex items-center justify-center shadow-md pointer-events-none z-20">
                      {numberBadge}
                    </div>
                  </div>
                </div>

                <!-- Decorative Golden Star Sparkle Accent on top-right corner -->
                <div class="absolute -top-2.5 -right-2.5 text-amber-300 pointer-events-none z-20 service-sparkle" aria-hidden="true">
                  <svg class="w-6 h-6 text-amber-300 drop-shadow-[0_0_8px_rgba(251,191,36,0.95)]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0L14.2 9.8L24 12L14.2 14.2L12 24L9.8 14.2L0 12L9.8 9.8L12 0Z" />
                  </svg>
                </div>
              </div>
            </div>

            {/* Text Column (6 cols) */}
            <div class={`lg:col-span-6 flex flex-col justify-center ${isEven ? 'lg:order-2 reveal-right' : 'lg:order-1 reveal-left'}`}>
              <h3 class="font-display text-2xl sm:text-3xl font-medium text-white mb-3 tracking-tight">
                {svc.name}
              </h3>
              <p class="text-white/70 text-xs sm:text-sm font-light leading-relaxed mb-6 max-w-md">
                {svc.description}
              </p>

              {/* Meta Line: Price | BOOK SESSION */}
              <div class="flex items-center gap-4 text-xs sm:text-sm">
                <span class="font-semibold text-white/90 tracking-wide">
                  From {svc.price.replace(/^From\s*/i, '')}
                </span>
                <span class="w-px h-3.5 bg-white/25"></span>
                <a 
                  href="/#booking" 
                  class="font-bold text-[11px] sm:text-xs uppercase tracking-[0.18em] text-[#9EC5EA] hover:text-white transition-colors flex items-center gap-1.5 group/link"
                >
                  <span>BOOK SESSION</span>
                  <svg class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  @keyframes serviceSparkleTwinkle {
    0%, 100% {
      transform: scale(0.9) rotate(0deg);
      opacity: 0.85;
      filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.7));
    }
    50% {
      transform: scale(1.2) rotate(15deg);
      opacity: 1;
      filter: drop-shadow(0 0 14px rgba(251, 191, 36, 1)) drop-shadow(0 0 20px rgba(56, 189, 248, 0.8));
    }
  }

  @keyframes serviceBorderShimmer {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .service-sparkle {
    animation: serviceSparkleTwinkle 3.2s ease-in-out infinite;
  }

  .service-shimmer-border {
    background: linear-gradient(135deg, #fcd34d 0%, #38bdf8 25%, #ffffff 50%, #7dd3fc 75%, #f59e0b 100%);
    background-size: 250% 250%;
    animation: serviceBorderShimmer 6s ease infinite;
  }
</style>
