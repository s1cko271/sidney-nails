---
import siteData from '../data/site.json';

const services = siteData.services.items;

// Tailored sizing and aspect ratios per service so the image fills the frame completely with ZERO empty gaps,
// while preserving the full view of the nail artistry.
const serviceCardStyles = [
  {
    // 01: Manicure (736 x 894 - ratio ~0.82)
    ratio: '736 / 894',
    maxWidth: 'max-w-[420px]',
    objectPosition: 'object-center'
  },
  {
    // 02: Pedicure Spa (612 x 408 - ratio 1.50)
    ratio: '612 / 408',
    maxWidth: 'max-w-[480px]',
    objectPosition: 'object-center'
  },
  {
    // 03: Dipping Powder (800 x 800 - ratio 1.00)
    ratio: '1 / 1',
    maxWidth: 'max-w-[420px]',
    objectPosition: 'object-center'
  },
  {
    // 04: Nail Enhancement (736 x 1104 - ratio ~0.67)
    ratio: '736 / 1104',
    maxWidth: 'max-w-[360px]',
    objectPosition: 'object-center'
  },
  {
    // 05: Polish Change & Add-ons (496 x 618 - ratio ~0.80)
    ratio: '496 / 618',
    maxWidth: 'max-w-[410px]',
    objectPosition: 'object-center'
  }
];
---

<section class="py-24 md:py-32 bg-[#0B1422] text-white relative overflow-hidden" id="services">
  <!-- Subtle ambient glow background -->
  <div class="absolute top-1/4 -left-32 w-96 h-96 bg-[#1B3A5C]/25 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-sky-900/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-[1080px] mx-auto px-6 sm:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-20 md:mb-24 reveal">
      <div class="inline-flex items-center justify-center px-4 py-1.5 rounded-full border border-sky-400/30 bg-sky-950/50 text-[#9EC5EA] text-[10px] sm:text-[11px] font-bold tracking-[0.25em] uppercase mb-4 shadow-[0_0_15px_rgba(56,189,248,0.1)]">
        OUR SERVICES
      </div>

      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-normal text-white mb-4 leading-[1.18] tracking-tight">
        Complete Nail Care <em class="italic font-normal text-[#9EC5EA]">&amp; Beauty</em><br />
        <em class="italic font-normal text-[#9EC5EA]">Services</em>
      </h2>

      <p class="text-white/70 max-w-xl mx-auto text-xs sm:text-sm font-light leading-relaxed mb-6">
        From classic manicures to creative nail art &mdash; we offer a full range of services using premium products for lasting results.
      </p>

      <!-- Ornamental Divider (── ◇ ──) -->
      <div class="flex items-center justify-center gap-3 opacity-60" aria-hidden="true">
        <span class="w-12 h-px bg-gradient-to-r from-transparent to-sky-300/50"></span>
        <span class="w-1.5 h-1.5 rotate-45 border border-sky-300/80 bg-sky-400/30"></span>
        <span class="w-12 h-px bg-gradient-to-l from-transparent to-sky-300/50"></span>
      </div>
    </div>

    <!-- Alternating Z-Pattern Services Grid -->
    <div class="space-y-20 md:space-y-28">
      {services.map((svc, index) => {
        const isEven = index % 2 === 0;
        const numberBadge = String(index + 1).padStart(2, '0');
        const style = serviceCardStyles[index] || {
          ratio: '4 / 3',
          maxWidth: 'max-w-[440px]',
          objectPosition: 'object-center'
        };

        return (
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
            
            {/* Image Column (6 cols) */}
            <div class={`lg:col-span-6 flex ${isEven ? 'lg:order-1 lg:justify-end reveal-left' : 'lg:order-2 lg:justify-start reveal-right'} justify-center`}>
              <div class={`relative group w-full ${style.maxWidth}`}>
                {/* Glowing Image Card Frame - Perfectly matched aspect ratio so zero empty space exists */}
                <div 
                  class="relative overflow-hidden rounded-[1.75rem] sm:rounded-[2rem] w-full bg-slate-900 border border-sky-400/35 shadow-[0_0_25px_rgba(56,189,248,0.14)] transition-all duration-500 group-hover:border-sky-300/60 group-hover:shadow-[0_0_35px_rgba(56,189,248,0.25)]"
                  style={`aspect-ratio: ${style.ratio};`}
                >
                  <img 
                    src={svc.image} 
                    alt={svc.name} 
                    class={`w-full h-full object-cover ${style.objectPosition} transition-transform duration-700 ease-out group-hover:scale-105`} 
                    loading="lazy" 
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>

                  {/* Circular Number Badge (01, 02, etc.) */}
                  <div class="absolute top-4 left-4 sm:top-5 sm:left-5 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white text-[#0B1422] font-body font-bold text-xs flex items-center justify-center shadow-md pointer-events-none z-10">
                    {numberBadge}
                  </div>
                </div>

                {/* Decorative Star Sparkle Accent on top-right corner */}
                <div class="absolute -top-1.5 -right-1.5 text-sky-300/90 pointer-events-none z-10" aria-hidden="true">
                  <svg class="w-4 h-4 text-sky-300 drop-shadow-[0_0_6px_rgba(56,189,248,0.8)]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0L14.2 9.8L24 12L14.2 14.2L12 24L9.8 14.2L0 12L9.8 9.8L12 0Z" />
                  </svg>
                </div>
              </div>
            </div>

            {/* Text Column (6 cols) */}
            <div class={`lg:col-span-6 flex flex-col justify-center ${isEven ? 'lg:order-2 reveal-right' : 'lg:order-1 reveal-left'}`}>
              <h3 class="font-display text-2xl sm:text-3xl font-medium text-white mb-3 tracking-tight">
                {svc.name}
              </h3>
              <p class="text-white/70 text-xs sm:text-sm font-light leading-relaxed mb-6 max-w-md">
                {svc.description}
              </p>

              {/* Meta Line: Price | BOOK SESSION */}
              <div class="flex items-center gap-4 text-xs sm:text-sm">
                <span class="font-semibold text-white/90 tracking-wide">
                  {svc.price}
                </span>
                <span class="w-px h-3.5 bg-white/25"></span>
                <a 
                  href="/#booking" 
                  class="font-bold text-[11px] sm:text-xs uppercase tracking-[0.18em] text-[#9EC5EA] hover:text-white transition-colors flex items-center gap-1.5 group/link"
                >
                  <span>BOOK SESSION</span>
                  <svg class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
