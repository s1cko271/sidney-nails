---
import siteData from '../data/site.json';
---
<section class="py-24 md:py-32 relative bg-brand-charcoal" id="services">
  <div class="max-w-[1200px] mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <div class="inline-block text-brand-gold text-[0.65rem] font-bold tracking-[0.2em] uppercase mb-4 border border-brand-gold/30 px-3 py-1 rounded-full">
        {siteData.services.sectionTag}
      </div>
      <h2 class="font-display lining-nums text-4xl md:text-5xl font-light text-white mb-4">
        {siteData.services.title} <span class="font-semibold italic text-brand-gold">{siteData.services.titleAccent}</span>
      </h2>
      <p class="text-white/60 leading-relaxed font-light text-justify [text-align-last:center]">
        {siteData.services.subtitle}
      </p>
      <div class="flex items-center justify-center gap-3 mt-8 opacity-70" aria-hidden="true">
        <span class="w-12 h-px bg-brand-gold"></span>
        <span class="text-brand-gold opacity-80 transition-transform duration-700 hover:scale-110 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 22C12 22 20 18 20 12C20 6 12 2 12 2C12 2 4 6 4 12C4 18 12 22 12 22Z"/></svg>
        </span>
        <span class="w-12 h-px bg-brand-gold"></span>
      </div>
    </div>

    <div class="space-y-24 lg:space-y-32 mt-10">
      {siteData.services.items.map((svc, index) => (
        <div class={`flex flex-col ${index % 2 !== 0 ? 'lg:flex-row-reverse' : 'lg:flex-row'} items-center gap-10 lg:gap-20 reveal`}>
          <div class="w-full lg:w-1/2 relative">
            <div class="relative overflow-hidden rounded-[3rem] aspect-[4/3] md:aspect-[3/2] shadow-glow border-2 border-brand-luxury/50 group">
              <img class="w-full h-full object-cover object-center transition-transform duration-1000 group-hover:scale-110" src={svc.image} alt={svc.name} loading="lazy" />
              <div class="absolute inset-0 bg-brand-charcoal/10 mix-blend-multiply group-hover:opacity-0 transition-opacity duration-700"></div>
              <div class="absolute top-6 left-6 w-12 h-12 rounded-full bg-white/95 flex items-center justify-center text-brand-charcoal text-sm font-bold font-body shadow-lg">
                {String(index + 1).padStart(2, '0')}
              </div>
            </div>
          </div>
          <div class="w-full lg:w-1/2 flex flex-col justify-center">
            <h3 class="font-display lining-nums text-3xl md:text-4xl text-white font-semibold mb-6 tracking-wide">{svc.name}</h3>
            <p class="text-white/70 text-base md:text-lg leading-relaxed mb-8 font-light max-w-lg">{svc.description}</p>
            <div class="flex items-center gap-8">
              <div class="font-display lining-nums font-semibold text-brand-gold text-2xl tracking-wide -translate-y-0.5">{svc.price}</div>
              <div class="w-px h-8 bg-white/20"></div>
              <a href="/#booking" class="text-xs font-bold uppercase tracking-widest text-brand-gold hover:text-white transition-colors flex items-center gap-2 group">
                Book Session
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover:translate-x-1 transition-transform"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

