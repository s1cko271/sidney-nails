---
import siteData from '../data/site.json';
---
<section id="hero" class="relative min-h-[92dvh] lg:min-h-[96dvh] flex flex-col lg:flex-row bg-white overflow-hidden">
  <!-- Left Side: Content (7/12 on lg) -->
  <div class="w-full lg:w-7/12 flex items-center justify-center px-6 sm:px-12 pt-32 pb-16 lg:py-24 z-10">
    <div class="w-full max-w-xl text-left">
      <!-- Full Logo Mark -->
      <div class="mb-8 reveal">
        <img 
          class="w-48 sm:w-56 h-auto object-contain" 
          src={siteData.salon.logoFull || '/images/logo-full.webp'} 
          alt={siteData.salon.name} 
        />
      </div>

      <!-- Tagline Pill -->
      <div class="inline-block text-[#1B3A5C] text-[0.7rem] font-semibold tracking-[0.2em] uppercase mb-6 px-4 py-1.5 border border-brand-gold/40 rounded-full bg-brand-offwhite reveal">
        {siteData.salon.tagline} &middot; {siteData.salon.city}, {siteData.salon.state}
      </div>
      
      <!-- Primary Heading -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-brand-charcoal leading-[1.12] font-normal tracking-tight mb-6 reveal">
        {siteData.hero.headlineLine1} <br/>
        <em class="font-medium italic text-brand-gold">{siteData.hero.headlineLine2}</em>
      </h1>
      
      <!-- Subtitle -->
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-10 font-light max-w-lg reveal">
        {siteData.hero.description}
      </p>
      
      <!-- Call to Actions -->
      <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center reveal">
        <a 
          class="bg-[#1B3A5C] text-white px-8 py-3.5 rounded-full font-bold text-xs uppercase tracking-widest hover:bg-brand-gold hover:text-[#1B3A5C] transition-all duration-300 text-center shadow-md hover:-translate-y-0.5" 
          href="/#booking"
        >
          {siteData.hero.ctaPrimary}
        </a>
        <a 
          class="bg-transparent border border-slate-300 text-[#1B3A5C] px-8 py-3.5 rounded-full font-semibold text-xs uppercase tracking-widest hover:border-[#1B3A5C] hover:bg-brand-offwhite transition-all duration-300 text-center" 
          href={`tel:${siteData.salon.phoneRaw}`}
        >
          {siteData.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>

  <!-- Right Side: Real Salon Photo (5/12 on lg) -->
  <div class="w-full lg:w-5/12 min-h-[340px] sm:min-h-[420px] lg:min-h-full relative flex items-stretch">
    <div class="w-full h-full relative overflow-hidden lg:rounded-l-3xl shadow-xl">
      <img 
        src={siteData.salon.interiorImage} 
        alt="Sidney Nails Interior Salon Space" 
        class="w-full h-full object-cover min-h-[340px]" 
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1B3A5C]/30 via-transparent to-transparent lg:bg-gradient-to-r lg:from-[#1B3A5C]/20 lg:to-transparent"></div>
    </div>
  </div>
</section>

<!-- Scrolling Services Ticker (Marquee) -->
<div class="py-4 bg-[#1B3A5C] overflow-hidden border-y border-[#2D5A8B]/60" aria-label="Services Ticker">
  <div class="flex gap-14 animate-[scrollX_32s_linear_infinite] w-max hover:[animation-play-state:paused] transition-all cursor-default">
    {siteData.marquee.items.map(item => (
      <span class="font-body text-xs sm:text-sm text-white/90 uppercase tracking-widest whitespace-nowrap flex items-center gap-14 font-medium">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
      </span>
    ))}
    {siteData.marquee.items.map(item => (
      <span class="font-body text-xs sm:text-sm text-white/90 uppercase tracking-widest whitespace-nowrap flex items-center gap-14 font-medium">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
      </span>
    ))}
  </div>
</div>
