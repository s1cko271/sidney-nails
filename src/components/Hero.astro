---
import siteData from '../data/site.json';
---
<section id="hero" class="relative min-h-[90dvh] lg:min-h-[92dvh] flex flex-col justify-center bg-white/75 backdrop-blur-md overflow-hidden pt-28 pb-16 lg:pt-32 lg:pb-20">
  <!-- Subtle decorative organic leaf background float -->
  <div class="absolute -top-12 -right-12 w-96 h-96 bg-brand-light-blue/20 rounded-full blur-3xl pointer-events-none leaf-float"></div>
  <div class="absolute bottom-10 left-10 w-72 h-72 bg-brand-gold/10 rounded-full blur-2xl pointer-events-none"></div>

  <div class="max-w-[1180px] mx-auto px-6 sm:px-8 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      <!-- Left Side: Content (7/12 on lg) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Brand Logo (Horizontal Brand Lockup) -->
        <div class="hero-animate-logo mb-6 sm:mb-8">
          <a href="/" class="inline-block transition-transform duration-300 hover:scale-[1.02] focus:outline-none" aria-label={siteData.salon.name}>
            <picture>
              <source srcset="/images/logo-horizontal.webp" type="image/webp" />
              <img 
                src="/images/logo-horizontal.png" 
                alt={siteData.salon.name} 
                class="h-14 sm:h-18 md:h-20 lg:h-24 w-auto max-w-[280px] sm:max-w-[340px] md:max-w-[380px] object-contain select-none filter drop-shadow-[0_2px_12px_rgba(27,58,92,0.08)]" 
                loading="eager"
                fetchpriority="high"
                width="1136"
                height="480"
              />
            </picture>
          </a>
        </div>

        <!-- Tagline Pill with leaf dot -->
        <div class="hero-animate-tagline inline-flex items-center gap-2 text-brand-navy text-[0.7rem] sm:text-xs font-semibold tracking-[0.2em] uppercase mb-6 px-4 py-1.5 border border-brand-gold/50 rounded-full bg-brand-offwhite shadow-sm">
          <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
          <span>{siteData.salon.tagline} &middot; {siteData.salon.city}, {siteData.salon.state}</span>
        </div>
        
        <!-- Primary Heading -->
        <h1 class="hero-animate-heading font-display text-4xl sm:text-5xl lg:text-[3.6rem] text-brand-navy leading-[1.12] font-normal tracking-tight mb-6">
          {siteData.hero.headlineLine1} <br/>
          <em class="font-medium italic text-brand-gold">{siteData.hero.headlineLine2}</em>
        </h1>
        
        <!-- Subtitle -->
        <p class="hero-animate-subtext text-slate-600 text-base sm:text-lg leading-relaxed mb-8 font-light max-w-xl">
          {siteData.hero.description}
        </p>
        
        <!-- Call to Actions -->
        <div class="hero-animate-cta flex flex-col sm:flex-row gap-4 items-stretch sm:items-center w-full sm:w-auto">
          <a 
            class="bg-brand-navy text-white px-8 py-3.5 rounded-full font-bold text-xs uppercase tracking-widest hover:bg-brand-gold hover:text-brand-navy transition-all duration-300 text-center shadow-md hover:-translate-y-0.5 active:translate-y-0" 
            href={siteData.booking?.messengerUrl || "https://m.me/sidneynailsmontana"}
            target="_blank"
            rel="noopener noreferrer"
          >
            {siteData.hero.ctaPrimary}
          </a>
          <a 
            class="bg-transparent border border-slate-300 text-brand-navy px-8 py-3.5 rounded-full font-semibold text-xs uppercase tracking-widest hover:border-brand-navy hover:bg-brand-offwhite transition-all duration-300 text-center hover:-translate-y-0.5 active:translate-y-0" 
            href={`tel:${siteData.salon.phoneRaw}`}
          >
            {siteData.hero.ctaSecondary}
          </a>
        </div>
      </div>

      <!-- Right Side: Real Salon Photo (5/12 on lg) -->
      <div class="lg:col-span-5 hero-animate-image">
        <!-- Relative card wrapper for sparkles and glow -->
        <div class="relative group mx-auto max-w-[480px] lg:max-w-none">
          
          <!-- Ambient Luminous Backlight Glow -->
          <div class="absolute -inset-1 sm:-inset-1.5 rounded-[2rem] sm:rounded-[2.25rem] bg-gradient-to-tr from-sky-400/35 via-sky-200/45 to-blue-600/35 blur-xl opacity-75 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

          <!-- Sparkling Gradient Border Frame -->
          <div class="relative p-[2.5px] sm:p-[3px] rounded-[1.85rem] sm:rounded-[2.1rem] hero-shimmer-border shadow-[0_0_30px_rgba(56,189,248,0.32),0_20px_45px_rgba(27,58,92,0.16)] ring-2 ring-white/90 transition-all duration-500 group-hover:shadow-[0_0_42px_rgba(56,189,248,0.48)]">
            
            <!-- Inner Image Container with Overflow Hidden -->
            <div class="relative rounded-[calc(1.85rem-2.5px)] sm:rounded-[calc(2.1rem-3px)] overflow-hidden aspect-[4/5] sm:aspect-[4/3] lg:aspect-[4/5] max-h-[540px] bg-slate-900">
              <img 
                src={siteData.salon.interiorImage} 
                alt="Sidney Nails Interior Salon Space" 
                class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105" 
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/35 via-transparent to-transparent pointer-events-none"></div>
              
              <!-- Floating Badge: Certified & Licensed / Sidney, MT -->
              <div class="hero-animate-subtext absolute bottom-4 sm:bottom-5 left-4 sm:left-5 right-4 sm:right-5 bg-white/95 backdrop-blur-md rounded-2xl p-3.5 sm:p-4 shadow-lg border border-sky-200/70 flex items-center justify-between pointer-events-none">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-sky-50 flex items-center justify-center text-sky-500">
                    <svg class="w-5 h-5 text-sky-500" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-bold text-brand-navy">Licensed Nail Salon</p>
                    <p class="text-[0.7rem] text-slate-500">{siteData.salon.fullAddress}</p>
                  </div>
                </div>
                <span class="text-[0.65rem] font-bold uppercase tracking-wider text-sky-600 bg-sky-50 px-2.5 py-1 rounded-full border border-sky-200/80">Open Mon-Sat</span>
              </div>
            </div>
          </div>

          <!-- Decorative Sparkle Star Accents (Viền lấp lánh) -->
          <!-- Sparkle 1: Top Right primary twinkle -->
          <div class="absolute -top-3.5 -right-3.5 text-sky-400 pointer-events-none z-20 hero-sparkle-1" aria-hidden="true">
            <svg class="w-7 h-7 sm:w-8 sm:h-8 text-sky-400 drop-shadow-[0_0_12px_rgba(56,189,248,0.95)]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L14.2 9.8L24 12L14.2 14.2L12 24L9.8 14.2L0 12L9.8 9.8L12 0Z" />
            </svg>
          </div>

          <!-- Sparkle 2: Top Right companion tiny twinkle -->
          <div class="absolute -top-1 -right-7 sm:-right-8 text-sky-300 pointer-events-none z-20 hero-sparkle-2" aria-hidden="true">
            <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-sky-300 drop-shadow-[0_0_8px_rgba(56,189,248,0.85)]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L14.2 9.8L24 12L14.2 14.2L12 24L9.8 14.2L0 12L9.8 9.8L12 0Z" />
            </svg>
          </div>

          <!-- Sparkle 3: Bottom Left accent twinkle -->
          <div class="absolute -bottom-2.5 -left-2.5 text-sky-400 pointer-events-none z-20 hero-sparkle-3" aria-hidden="true">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-sky-400 drop-shadow-[0_0_10px_rgba(56,189,248,0.9)]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L14.2 9.8L24 12L14.2 14.2L12 24L9.8 14.2L0 12L9.8 9.8L12 0Z" />
            </svg>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<!-- Scrolling Services Ticker (Marquee) -->
<div class="py-4 bg-[#1B3A5C] overflow-hidden border-y border-[#2D5A8B]/60" aria-label="Services Ticker">
  <div class="marquee-track flex gap-14 cursor-default">
    {siteData.marquee.items.map(item => (
      <span class="font-body text-xs sm:text-sm text-white/90 uppercase tracking-widest whitespace-nowrap flex items-center gap-14 font-medium">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
      </span>
    ))}
    {siteData.marquee.items.map(item => (
      <span class="font-body text-xs sm:text-sm text-white/90 uppercase tracking-widest whitespace-nowrap flex items-center gap-14 font-medium">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes heroSparkleTwinkle {
    0%, 100% {
      transform: scale(0.9) rotate(0deg);
      opacity: 0.85;
      filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.7));
    }
    50% {
      transform: scale(1.22) rotate(15deg);
      opacity: 1;
      filter: drop-shadow(0 0 16px rgba(56, 189, 248, 1)) drop-shadow(0 0 20px rgba(255, 255, 255, 0.95));
    }
  }

  @keyframes heroSparklePulse {
    0%, 100% {
      transform: scale(0.75) rotate(0deg);
      opacity: 0.6;
    }
    50% {
      transform: scale(1.15) rotate(-15deg);
      opacity: 1;
      filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.9));
    }
  }

  @keyframes heroBorderShimmer {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .hero-sparkle-1 {
    animation: heroSparkleTwinkle 3s ease-in-out infinite;
  }

  .hero-sparkle-2 {
    animation: heroSparklePulse 2.4s ease-in-out infinite 0.5s;
  }

  .hero-sparkle-3 {
    animation: heroSparkleTwinkle 3.5s ease-in-out infinite 1.2s;
  }

  .hero-shimmer-border {
    background: linear-gradient(135deg, #38bdf8 0%, #ffffff 25%, #7dd3fc 50%, #bae6fd 75%, #38bdf8 100%);
    background-size: 250% 250%;
    animation: heroBorderShimmer 6s ease infinite;
  }
</style>
