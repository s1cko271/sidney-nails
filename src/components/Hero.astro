---
import siteData from '../data/site.json';
---
<section id="hero" class="relative min-h-[100dvh] flex flex-col lg:flex-row bg-brand-cream overflow-hidden">
  <!-- Left Side: Content -->
  <div class="w-full lg:w-7/12 flex items-center justify-center p-6 pt-32 pb-16 lg:pt-0 lg:pb-0 z-10">
    <div class="w-full max-w-2xl relative">
      <img class="w-64 md:w-80 h-auto mb-8 animate-fade-in-up object-contain" src={siteData.salon.logoFull} alt={siteData.salon.name} />
      
      <div class="inline-block text-brand-goldDark text-[0.65rem] font-semibold tracking-[0.2em] uppercase mb-6 px-4 py-1.5 border border-brand-goldDark/20 rounded-full bg-brand-goldLight/10 animate-fade-in-up" style="animation-delay: 150ms;">
        {siteData.salon.tagline} &middot; {siteData.salon.city}, {siteData.salon.state}
      </div>
      
      <h1 class="font-display lining-nums text-5xl md:text-6xl lg:text-7xl xl:text-8xl text-brand-charcoal leading-[1.05] font-normal tracking-tight mb-6 animate-fade-in-up" style="animation-delay: 300ms;">
        {siteData.hero.headlineLine1}<br/>
        <em class="font-semibold italic text-brand-gold">{siteData.hero.headlineLine2}</em>
      </h1>
      
      <p class="text-brand-charcoal/75 text-base md:text-lg lg:text-xl max-w-lg leading-relaxed mb-10 font-light animate-fade-in-up" style="animation-delay: 450ms;">
        {siteData.hero.description}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center opacity-0 animate-fade-in-up" style="animation-delay: 600ms;">
        <a class="w-full sm:w-auto bg-brand-charcoal text-brand-cream px-10 py-4 rounded-full font-bold text-[0.85rem] uppercase tracking-widest shadow-lg hover:bg-brand-gold hover:text-brand-charcoal hover:-translate-y-1 transition-all duration-300 text-center" href="/#booking">
          {siteData.hero.ctaPrimary}
        </a>
        <a class="w-full sm:w-auto bg-transparent border border-brand-charcoal/20 text-brand-charcoal px-8 py-4 rounded-full font-medium text-[0.85rem] uppercase tracking-widest hover:border-brand-gold hover:text-brand-gold transition-colors duration-300 text-center" href={`tel:${siteData.salon.bookingPhoneRaw}`}>
          {siteData.hero.ctaSecondary}
        </a>
      </div>
      
      <!-- TODO: Uncomment and populate with real stats when available
      <div class="flex gap-10 mt-16 pt-8 border-t border-brand-charcoal/10 opacity-0 animate-fade-in-up" style="animation-delay: 750ms;">
        {siteData.hero.stats.map(stat => (
          <div>
            <div class="font-display lining-nums text-4xl text-brand-charcoal font-bold mb-1">{stat.value}</div>
            <div class="text-brand-charcoal/50 text-[0.65rem] uppercase tracking-widest">{stat.label}</div>
          </div>
        ))}
      </div>
      -->
    </div>
  </div>

  <!-- Right Side: Image -->
  <div class="w-full lg:w-5/12 min-h-[50vh] lg:min-h-screen relative lg:absolute lg:top-0 lg:right-0">
    <div class="absolute inset-0 bg-cover bg-center animate-slow-pan lg:rounded-l-[3rem] overflow-hidden" style={`background-image: url('${siteData.salon.interiorImage}')`}>
      <div class="absolute inset-0 bg-brand-charcoal/10"></div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="py-4 bg-brand-charcoal overflow-hidden border-b border-white/5">
  <div class="flex gap-12 animate-[scrollX_30s_linear_infinite] w-max hover:[animation-play-state:paused] transition-all cursor-default">
    {siteData.marquee.items.map(item => (
      <span class="font-display lining-nums text-xl text-brand-cream/80 whitespace-nowrap flex items-center gap-6 tracking-wide hover:text-brand-gold transition-colors">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
      </span>
    ))}
    {siteData.marquee.items.map(item => (
      <span class="font-display lining-nums text-xl text-brand-cream/80 whitespace-nowrap flex items-center gap-6 tracking-wide hover:text-brand-gold transition-colors">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
      </span>
    ))}
  </div>
</div>

<style>
  .glow-white {
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.4), 0 0 40px rgba(255, 255, 255, 0.2);
  }
  .glow-gold {
    text-shadow: 0 0 15px rgba(159, 184, 212, 0.4), 0 0 30px rgba(235, 165, 205, 0.3);
  }
</style>
