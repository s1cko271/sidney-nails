---
import siteData from '../data/site.json';
---
<section id="hero" class="relative min-h-[100dvh] flex flex-col lg:flex-row bg-brand-cream overflow-hidden">
  <!-- Left Side: Content -->
  <div class="w-full lg:w-1/2 flex items-center justify-center p-8 pt-32 pb-16 lg:p-16 z-10">
    <div class="w-full max-w-xl relative text-left">
      <img class="w-48 h-auto mb-10 object-contain animate-fade-in-up" src={siteData.salon.logoFull} alt={siteData.salon.name} />
      
      <div class="inline-block text-brand-luxury text-xs font-semibold tracking-[0.2em] uppercase mb-6 px-4 py-1.5 border border-brand-gold/30 rounded-full bg-brand-goldLight/20 animate-fade-in-up" style="animation-delay: 150ms;">
        {siteData.salon.tagline} &middot; {siteData.salon.city}, {siteData.salon.state}
      </div>
      
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-brand-charcoal leading-[1.1] font-medium tracking-tight mb-6 animate-fade-in-up" style="animation-delay: 300ms;">
        {siteData.hero.headlineLine1}<br/>
        <em class="font-medium italic text-brand-gold">{siteData.hero.headlineLine2}</em>
      </h1>
      
      <p class="text-brand-charcoal/80 text-lg md:text-xl max-w-lg leading-relaxed mb-10 font-light animate-fade-in-up" style="animation-delay: 450ms;">
        {siteData.hero.description}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center opacity-0 animate-fade-in-up" style="animation-delay: 600ms;">
        <a class="w-full sm:w-auto bg-brand-luxury text-brand-cream px-10 py-4 rounded-none font-medium text-sm uppercase tracking-widest hover:bg-brand-gold hover:-translate-y-1 transition-all duration-300 text-center" href="/#booking">
          {siteData.hero.ctaPrimary}
        </a>
        <a class="w-full sm:w-auto bg-transparent border border-brand-luxury/20 text-brand-luxury px-8 py-4 rounded-none font-medium text-sm uppercase tracking-widest hover:border-brand-luxury transition-colors duration-300 text-center" href={`tel:${siteData.salon.bookingPhoneRaw}`}>
          {siteData.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>

  <!-- Right Side: Image -->
  <div class="w-full lg:w-1/2 min-h-[50vh] lg:min-h-screen relative lg:absolute lg:top-0 lg:right-0">
    <div class="absolute inset-0 bg-cover bg-center lg:rounded-l-2xl overflow-hidden shadow-2xl" style={`background-image: url('${siteData.salon.interiorImage}')`}>
      <div class="absolute inset-0 bg-brand-luxury/10 mix-blend-multiply"></div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="py-5 bg-brand-offwhite overflow-hidden border-b border-brand-luxury/5">
  <div class="flex gap-16 animate-[scrollX_30s_linear_infinite] w-max hover:[animation-play-state:paused] transition-all cursor-default">
    {siteData.marquee.items.map(item => (
      <span class="font-body text-sm text-brand-luxury/70 uppercase tracking-widest whitespace-nowrap flex items-center gap-16">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold/50"></span>
      </span>
    ))}
    {siteData.marquee.items.map(item => (
      <span class="font-body text-sm text-brand-luxury/70 uppercase tracking-widest whitespace-nowrap flex items-center gap-16">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold/50"></span>
      </span>
    ))}
  </div>
</div>
