---
import siteData from '../data/site.json';
---
<section class="relative min-h-screen flex items-center justify-center bg-brand-charcoal overflow-hidden pt-24 md:pt-0">
  <video class="absolute inset-0 w-full h-full object-cover brightness-[0.5]" autoplay muted loop playsinline><source src="/videos/2.mp4" type="video/mp4" /></video>
  <div class="absolute inset-0 bg-gradient-to-b from-brand-charcoal/20 to-brand-charcoal/70"></div>
  
  <div class="relative text-center max-w-4xl px-6 z-10 w-full mt-20 md:mt-28">
    <img class="w-24 h-24 md:w-36 md:h-36 rounded-full object-cover mx-auto mb-8 border-4 border-brand-gold shadow-[0_0_30px_rgba(212,175,55,0.6)] animate-fade-in-up bg-white p-1" src={siteData.salon.logoImage} alt={siteData.salon.name} />
    
    <div class="inline-block text-brand-goldLight text-[0.65rem] md:text-xs font-semibold tracking-[0.2em] uppercase mb-6 px-5 py-2 border border-brand-gold/30 rounded-full bg-brand-charcoal/20 backdrop-blur-sm animate-fade-in-up" style="animation-delay: 150ms;">
      {siteData.salon.tagline} &middot; {siteData.salon.city}, {siteData.salon.state}
    </div>
    
    <h1 class="font-display text-4xl md:text-5xl lg:text-7xl text-white leading-[1.1] font-light tracking-tight mb-4 animate-fade-in-up glow-white" style="animation-delay: 300ms;">
      {siteData.hero.headlineLine1}<br/>
      <em class="font-semibold italic text-brand-goldLight glow-gold">{siteData.hero.headlineLine2}</em>
    </h1>
    
    <div class="flex items-center justify-center gap-3 my-8 opacity-0 animate-fade-in-up" style="animation-delay: 450ms;" aria-hidden="true">
      <span class="w-16 h-px bg-brand-gold"></span>
      <span class="text-brand-gold text-xs animate-spin-slow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z"/></svg></span>
      <span class="w-16 h-px bg-brand-gold"></span>
    </div>

    <p class="text-brand-cream/70 text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-10 font-light animate-fade-in-up" style="animation-delay: 600ms;">
      {siteData.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center opacity-0 animate-fade-in-up" style="animation-delay: 750ms;">
      <a class="w-full sm:w-auto bg-brand-gold text-brand-charcoal px-10 py-4 rounded-full font-bold text-[0.9rem] uppercase tracking-widest shadow-lg hover:shadow-glow hover:-translate-y-1 transition-all duration-300 btn-shine" href="/#booking">
        {siteData.hero.ctaPrimary}
      </a>
      <a class="w-full sm:w-auto bg-transparent border border-brand-cream/30 text-brand-cream px-8 py-4 rounded-full font-medium text-sm uppercase tracking-widest hover:bg-brand-cream/10 transition-colors duration-300" href="/#services">
        {siteData.hero.ctaSecondary}
      </a>
    </div>
    
    <div class="grid grid-cols-2 sm:flex sm:flex-wrap justify-center gap-4 md:gap-12 mt-16 pt-8 border-t border-brand-cream/10 opacity-0 animate-fade-in-up" style="animation-delay: 900ms;">
      {siteData.hero.stats.map(stat => (
        <div class="text-center">
          <div class="font-display text-3xl md:text-4xl text-brand-goldLight font-bold">{stat.value}</div>
          <div class="text-brand-cream/50 text-[0.7rem] uppercase tracking-wider mt-1">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="py-4 bg-brand-charcoal overflow-hidden border-b border-white/5">
  <div class="flex gap-12 animate-[scrollX_30s_linear_infinite] w-max hover:[animation-play-state:paused] transition-all cursor-default">
    {siteData.marquee.items.map(item => (
      <span class="font-display text-xl text-brand-cream/80 whitespace-nowrap flex items-center gap-6 tracking-wide hover:text-brand-gold transition-colors">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
      </span>
    ))}
    {siteData.marquee.items.map(item => (
      <span class="font-display text-xl text-brand-cream/80 whitespace-nowrap flex items-center gap-6 tracking-wide hover:text-brand-gold transition-colors">
        {item} <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
      </span>
    ))}
  </div>
</div>

<style>
  .glow-white {
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.4), 0 0 40px rgba(255, 255, 255, 0.2);
  }
  .glow-gold {
    text-shadow: 0 0 20px rgba(212, 175, 55, 0.6), 0 0 40px rgba(212, 175, 55, 0.4);
  }
</style>
