---
import siteData from '../data/site.json';
import '../styles/global.css';

const title = `${siteData.salon.name} - Connect With Us`;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <meta name="description" content="Connect with Sidney Nails on social media, find directions, or leave a review." />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</head>
<body class="font-body antialiased min-h-screen bg-[#1B3A5C] text-white flex flex-col items-center justify-center relative overflow-x-hidden selection:bg-brand-gold selection:text-[#1B3A5C]">
  
  <!-- Ambient Salon Interior Background -->
  <div class="fixed inset-0 bg-cover bg-center bg-no-repeat brightness-[0.35] pointer-events-none" style={`background-image: url('${siteData.salon.interiorImage}')`}></div>
  <div class="fixed inset-0 bg-gradient-to-b from-[#1B3A5C]/40 via-[#1B3A5C]/70 to-[#1B3A5C]/95 pointer-events-none"></div>

  <!-- Main Container -->
  <main class="w-full max-w-md px-6 py-12 relative z-10 flex flex-col items-center flex-grow justify-center min-h-screen">
    
    <!-- Logo & Greeting -->
    <div class="flex flex-col items-center animate-fade-in-up text-center mb-8" style="animation-delay: 100ms;">
      <a href="/" class="group">
        <img class="w-24 h-24 md:w-28 md:h-28 rounded-full object-contain bg-white p-2 border-2 border-brand-gold shadow-lg mb-6 group-hover:scale-105 transition-transform" src={siteData.salon.logoSquare || '/images/logo.png'} alt={siteData.salon.name} />
      </a>

      <h1 class="font-display text-3xl md:text-4xl font-normal text-white mb-3 tracking-wide">
        {siteData.salon.name}
      </h1>
      
      <p class="text-white/75 text-sm max-w-xs font-light leading-relaxed">
        {siteData.connect.greeting || "Welcome to Sidney Nails. A calm, intimate space for your beauty and relaxation."}
      </p>

      <div class="w-12 h-px bg-white/20 mt-6"></div>
    </div>

    <!-- Quick Action Links -->
    <div class="w-full flex flex-col gap-3.5 mb-12 animate-fade-in-up" style="animation-delay: 250ms;">
      <!-- Google Review -->
      <a href={siteData.social.googleReviews.startsWith('TODO') ? 'https://maps.app.goo.gl/th34qAzZDDTthUoLA' : siteData.social.googleReviews} target="_blank" rel="noopener noreferrer" class="group relative w-full bg-white/10 hover:bg-white/20 backdrop-blur-md rounded-2xl px-5 py-4 flex items-center gap-4 shadow-md border border-white/20 hover:border-brand-gold hover:-translate-y-0.5 transition-all duration-300">
        <div class="w-11 h-11 rounded-xl bg-white flex items-center justify-center shrink-0 shadow-sm">
          <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        </div>
        <div class="flex flex-col text-left flex-grow">
          <span class="font-bold text-white text-sm tracking-wide">Leave a Review (Save Extra 5%)</span>
          <span class="text-xs text-white/60">Share your experience on Google</span>
        </div>
        <svg class="w-4 h-4 text-white/50 group-hover:text-brand-gold transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>

      <!-- Facebook -->
      <a href={siteData.social.facebook.startsWith('TODO') ? 'https://www.facebook.com' : siteData.social.facebook} target="_blank" rel="noopener noreferrer" class="group relative w-full bg-white/10 hover:bg-white/20 backdrop-blur-md rounded-2xl px-5 py-4 flex items-center gap-4 shadow-md border border-white/20 hover:border-brand-gold hover:-translate-y-0.5 transition-all duration-300">
        <div class="w-11 h-11 rounded-xl bg-[#1877F2] flex items-center justify-center shrink-0 text-white shadow-sm">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </div>
        <div class="flex flex-col text-left flex-grow">
          <span class="font-bold text-white text-sm tracking-wide">Facebook</span>
          <span class="text-xs text-white/60">Follow for updates &amp; 10% off</span>
        </div>
        <svg class="w-4 h-4 text-white/50 group-hover:text-brand-gold transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>

      <!-- Instagram -->
      <a href={siteData.social.instagram.startsWith('TODO') ? 'https://www.instagram.com' : siteData.social.instagram} target="_blank" rel="noopener noreferrer" class="group relative w-full bg-white/10 hover:bg-white/20 backdrop-blur-md rounded-2xl px-5 py-4 flex items-center gap-4 shadow-md border border-white/20 hover:border-brand-gold hover:-translate-y-0.5 transition-all duration-300">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-[#FD1D1D] via-[#E1306C] to-[#C13584] flex items-center justify-center shrink-0 text-white shadow-sm">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </div>
        <div class="flex flex-col text-left flex-grow">
          <span class="font-bold text-white text-sm tracking-wide">Instagram</span>
          <span class="text-xs text-white/60">See our latest nail artistry</span>
        </div>
        <svg class="w-4 h-4 text-white/50 group-hover:text-brand-gold transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>

      <!-- TikTok -->
      <a href={siteData.social.tiktok.startsWith('TODO') ? 'https://www.tiktok.com' : siteData.social.tiktok} target="_blank" rel="noopener noreferrer" class="group relative w-full bg-white/10 hover:bg-white/20 backdrop-blur-md rounded-2xl px-5 py-4 flex items-center gap-4 shadow-md border border-white/20 hover:border-brand-gold hover:-translate-y-0.5 transition-all duration-300">
        <div class="w-11 h-11 rounded-xl bg-black flex items-center justify-center shrink-0 text-white shadow-sm">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 448 512"><path d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"/></svg>
        </div>
        <div class="flex flex-col text-left flex-grow">
          <span class="font-bold text-white text-sm tracking-wide">TikTok</span>
          <span class="text-xs text-white/60">Watch salon in action</span>
        </div>
        <svg class="w-4 h-4 text-white/50 group-hover:text-brand-gold transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>

      <!-- Website Home -->
      <a href="/" class="group relative w-full bg-brand-gold hover:bg-white text-[#1B3A5C] rounded-2xl px-5 py-4 flex items-center justify-center gap-3 shadow-md hover:-translate-y-0.5 transition-all duration-300 font-bold text-sm uppercase tracking-wider mt-2">
        <span>Visit Full Website</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </a>
    </div>

    <!-- Contact & Address Footer -->
    <div class="text-center w-full animate-fade-in-up text-xs text-white/70 space-y-1.5" style="animation-delay: 400ms;">
      <p class="font-medium text-white text-sm">{siteData.salon.fullAddress}</p>
      <p><a href={`tel:${siteData.salon.phoneRaw}`} class="hover:text-brand-gold transition-colors text-white font-semibold text-sm">{siteData.salon.phone}</a></p>
      <p class="text-[0.7rem] text-white/50 pt-2">&copy; {new Date().getFullYear()} {siteData.salon.name}</p>
    </div>
  </main>
</body>
</html>
