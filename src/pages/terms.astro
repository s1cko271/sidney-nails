---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';
---

<Layout title={`Terms of Service - ${siteData.salon.name}`}>
  <div class="pt-32 pb-24 bg-brand-cream min-h-screen">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-12 reveal">
        <div class="inline-block text-brand-gold text-xs font-bold tracking-[0.2em] uppercase mb-3">
          Agreement
        </div>
        <h1 class="font-display text-4xl md:text-5xl text-brand-charcoal mb-4">
          Terms of <em class="italic font-medium text-brand-gold">Service</em>
        </h1>
        <p class="text-slate-500 text-sm font-light">
          Last updated: {new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </p>
      </div>

      <div class="bg-white border border-slate-200/80 rounded-2xl p-8 md:p-12 shadow-sm reveal space-y-8 text-slate-600 leading-relaxed font-light text-sm md:text-base">
        <div>
          <h2 class="font-display text-xl md:text-2xl font-medium text-brand-charcoal mb-3">1. Agreement to Terms</h2>
          <p>By visiting, booking, or using the website and in-salon services of {siteData.salon.name}, you agree to abide by these terms and our posted salon policies.</p>
        </div>

        <div class="pt-8 border-t border-slate-100">
          <h2 class="font-display text-xl md:text-2xl font-medium text-brand-charcoal mb-3">2. Salon Services &amp; Appointments</h2>
          <p>We provide professional manicures, pedicures, acrylics, dipping, waxing, and beauty care. We make every effort to accommodate your requested time. We reserve the right to reschedule or refuse service in accordance with salon health, safety, and hygiene standards.</p>
        </div>

        <div class="pt-8 border-t border-slate-100">
          <h2 class="font-display text-xl md:text-2xl font-medium text-brand-charcoal mb-3">3. Cancellations &amp; Late Arrivals</h2>
          <p>Please notify us at least 24 hours in advance if you need to reschedule. Arrivals more than 15 minutes late may require adjusting or rescheduling your appointment to preserve scheduled times for other clients.</p>
        </div>

        <div class="pt-8 border-t border-slate-100">
          <h2 class="font-display text-xl md:text-2xl font-medium text-brand-charcoal mb-3">4. Questions &amp; Support</h2>
          <p>For inquiries regarding our terms, services, or appointments, please contact {siteData.salon.name} at <a href={`tel:${siteData.salon.phoneRaw}`} class="text-brand-gold hover:underline font-medium">{siteData.salon.phone}</a> or visit us at {siteData.salon.fullAddress}.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
